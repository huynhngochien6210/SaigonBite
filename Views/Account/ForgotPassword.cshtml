
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
}

<div class="verification-card">

    <div class="verification-icon">

        <svg width="45" height="45"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="1.7">

            <rect x="4" y="11"
                  width="16" height="11" rx="2"/>

            <path d="M8 11V7a4 4 0 0 1 8 0v4"/>

            <circle cx="12" cy="16" r="1"/>

        </svg>

    </div>

    <h1 data-i18n="forgotPassword">
        Forgot Password
    </h1>

    <p class="verification-description"
       data-i18n="forgotPasswordDescription">
        Choose your recovery method.
    </p>

    <form id="forgotPasswordForm">

        <div class="recovery-methods">

            <label class="recovery-option">

                <input type="radio"
                       name="recoveryMethod"
                       value="local"
                       checked>

                <span data-i18n="phoneNumber">
                    Phone Number
                </span>

            </label>

            <label class="recovery-option">

                <input type="radio"
                       name="recoveryMethod"
                       value="foreign">

                <span data-i18n="emailAddress">
                    Email Address
                </span>

            </label>

        </div>

        <div class="register-field" id="recoveryPhoneField">

            <label for="recoveryPhone"
                   data-i18n="phoneNumber">
                Phone Number
            </label>

            <input type="tel"
                   id="recoveryPhone"
                   placeholder="Enter your phone number"
                   data-i18n-placeholder="phonePlaceholder"
                   autocomplete="tel"
                   required>

        </div>

        <div class="register-field"
             id="recoveryEmailField"
             hidden>

            <label for="recoveryEmail"
                   data-i18n="emailAddress">
                Email Address
            </label>

            <input type="email"
                   id="recoveryEmail"
                   placeholder="Enter your email address"
                   data-i18n-placeholder="emailPlaceholder"
                   autocomplete="email"
                   disabled>

        </div>

        <p id="forgotPasswordMessage"
           class="recovery-message"
           role="status"></p>

        <button type="submit"
                class="verification-button"
                data-i18n="sendVerificationCode">
            Send Verification Code
        </button>

    </form>

    <a href="/Account/Login"
       class="verification-back"
       data-i18n="backToSignIn">
        ← Back to Sign In
    </a>

    <p class="verification-demo-note"
       data-i18n="verificationDemoNote">
        UI Preview - Backend is not connected.
    </p>

</div>

@section Scripts {
    <script src="/js/forgot-password.js"></script>
}
