
@model SaigonBite.ViewModels.OrderHistoryViewModel

@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Order History";

    var orders = Model.Orders;
}

<div class="account-page">

    @await Html.PartialAsync("_AccountSidebar")

    <section class="account-content">

        <div class="profile-heading">
            <h1 data-i18n="orderHistory">
                Order History
            </h1>
        </div>

        <p class="password-subtitle"
           data-i18n="orderHistorySubtitle">
            View your previous orders.
        </p>

        <!-- Search and Filter -->

        <div class="history-toolbar">

            <input type="search"
                   id="orderSearch"
                   class="form-control order-search"
                   placeholder="Search Order ID"
                   data-i18n-placeholder="searchOrderId">

            <select id="orderStatusFilter"
                    class="form-select history-filter">

                <option value="all"
                        data-i18n="allStatuses">
                    All Statuses
                </option>

                <option value="Placed" data-i18n="placed">
                    Placed
                </option>

                <option value="Confirmed" data-i18n="confirmed">
                    Confirmed
                </option>

                <option value="Preparing" data-i18n="preparing">
                    Preparing
                </option>

                <option value="Ready" data-i18n="ready">
                    Ready
                </option>

                <option value="OutForDelivery" data-i18n="outfordelivery">
                    Out for Delivery
                </option>

                <option value="Delivered"
                        data-i18n="delivered">
                    Delivered
                </option>

                <option value="Cancelled"
                        data-i18n="cancelled">
                    Cancelled
                </option>

                <option value="Failed"
                        data-i18n="orderFailed">
                    Failed
                </option>

            </select>

        </div>

        <!-- Order History Table -->

        <div class="table-responsive">

            <table class="table history-table">

                <thead>
                    <tr>

                        <th data-i18n="orderId">
                            Order ID
                        </th>

                        <th data-i18n="orderDate">
                            Order Date
                        </th>

                        <th data-i18n="orderTotal">
                            Total
                        </th>

                        <th data-i18n="status">
                            Status
                        </th>

                        <th data-i18n="action">
                            Action
                        </th>

                    </tr>
                </thead>

                <tbody id="orderHistoryBody">

                    @foreach (var order in orders)
                    {
                        var status = order.Status.ToString();

                        var statusText = status == "OutForDelivery"
                            ? "Out for Delivery"
                            : status;

                        var statusKey = status == "Failed"
                            ? "orderFailed"
                            : status.ToLowerInvariant();

                        var itemSummary = string.Join(
                            ", ",
                            order.Items.Select(
                                i => $"{i.ItemName} x{i.Quantity}"
                            )
                        );

                        <tr data-order-id="@order.OrderCode"
                            data-order-status="@status">

                            <td>
                                <strong>#@order.OrderCode</strong>
                            </td>

                            <td>
                                @order.OrderDate.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @order.Total.ToString(
                                    "N0",
                                    System.Globalization.CultureInfo
                                        .GetCultureInfo("vi-VN")
                                ) ₫
                            </td>

                            <td>

                                <span class="order-status @status.ToLowerInvariant()"
                                      data-i18n="@statusKey">

                                    @statusText

                                </span>

                            </td>

                            <td>

                                <button type="button"
                                        class="order-detail-button"
                                        data-order-detail
                                        data-id="@order.OrderCode"
                                        data-date="@order.OrderDate.ToString("dd/MM/yyyy")"
                                        data-item="@itemSummary"
                                        data-total="@order.Total.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        data-status="@status"
                                        data-payment="Not available"
                                        data-i18n="viewDetails">

                                    View Details

                                </button>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <!-- Empty Order History -->

        <div id="emptyOrderHistory"
             class="history-empty"
             hidden="@(orders.Count > 0)">

            <p data-i18n="noOrdersFound">
                No orders found.
            </p>

        </div>

        <!-- Total Orders -->

        <div class="history-footer">

            <span data-i18n="totalOrders">
                Total orders:
            </span>

            <strong id="orderRecordCount">
                @Model.TotalOrders
            </strong>

        </div>

    </section>

</div>

<!-- Order Detail Modal -->

<div class="modal fade"
     id="orderDetailModal"
     tabindex="-1"
     aria-labelledby="orderDetailTitle"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content order-modal-content">

            <!-- Modal Header -->

            <div class="modal-header">

                <h5 class="modal-title"
                    id="orderDetailTitle"
                    data-i18n="orderDetails">

                    Order Details

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <!-- Modal Body -->

            <div class="modal-body">

                <div class="order-detail-row">

                    <span data-i18n="orderId">
                        Order ID
                    </span>

                    <strong id="detailOrderId"></strong>

                </div>

                <div class="order-detail-row">

                    <span data-i18n="orderDate">
                        Order Date
                    </span>

                    <strong id="detailOrderDate"></strong>

                </div>

                <div class="order-detail-row">

                    <span data-i18n="orderItem">
                        Item
                    </span>

                    <strong id="detailOrderItem"></strong>

                </div>

                <div class="order-detail-row">

                    <span data-i18n="paymentMethod">
                        Payment Method
                    </span>

                    <strong id="detailOrderPayment"></strong>

                </div>

                <div class="order-detail-row">

                    <span data-i18n="status">
                        Status
                    </span>

                    <strong id="detailOrderStatus"></strong>

                </div>

                <hr>

                <div class="order-detail-row order-detail-total">

                    <span data-i18n="orderTotal">
                        Total
                    </span>

                    <strong id="detailOrderTotal"></strong>

                </div>

            </div>

            <!-- Modal Footer -->

            <div class="modal-footer">

                <button type="button"
                        class="profile-save-button"
                        data-bs-dismiss="modal"
                        data-i18n="close">

                    Close

                </button>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script src="/js/order-history.js"></script>
}
