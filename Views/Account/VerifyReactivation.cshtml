@model SaigonBite.ViewModels.VerifyReactivationViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Verify Reactivation";
}

<div class="auth-card">

    <div class="auth-heading">

        <h1>Verify Your Identity</h1>

        <p>
            Enter the 6-digit verification code
            to reactivate your account.
        </p>

    </div>

    @if (TempData["ReactivationMessage"] != null)
    {
        <div class="alert alert-success" role="status">

            @TempData["ReactivationMessage"]

        </div>
    }

    @if (TempData["ReactivationError"] != null)
    {
        <div class="alert alert-danger" role="alert">

            @TempData["ReactivationError"]

        </div>
    }

    <form method="post"
          action="@Url.Action("VerifyReactivation", "Account")">

        @Html.AntiForgeryToken()

        <div class="form-group">

            <label asp-for="Code">

                Verification Code

            </label>

            <input asp-for="Code"
                   type="text"
                   class="form-control auth-input"
                   placeholder="Enter 6-digit code"
                   maxlength="6"
                   minlength="6"
                   pattern="[0-9]{6}"
                   inputmode="numeric"
                   autocomplete="one-time-code"
                   required />

            <span asp-validation-for="Code"
                  class="text-danger">
            </span>

        </div>

        <div asp-validation-summary="ModelOnly"
             class="text-danger"
             role="alert">
        </div>

        <button type="submit"
                class="auth-button">

            Verify and Reactivate

        </button>

    </form>

    <div class="auth-divider">

        <span>OR</span>

    </div>

    <form method="post"
          action="@Url.Action("ResendReactivationCode", "Account")">

        @Html.AntiForgeryToken()

        <button type="submit"
                class="outline-button"
                style="width:100%;">

            Resend Verification Code

        </button>

    </form>

    <p class="text-center mt-3">

        The verification code expires after 5 minutes.

    </p>

    <form method="post"
          action="@Url.Action("CancelReactivation", "Account")">

        @Html.AntiForgeryToken()

        <button type="submit"
                class="outline-button"
                style="width:100%;">

            Cancel Reactivation

        </button>

    </form>

</div>