
@model SaigonBite.ViewModels.ChangePasswordViewModel

@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Change Password";
}

<div class="account-page">

    @await Html.PartialAsync("_AccountSidebar")

    <section class="account-content">

        <div class="profile-heading">
            <h1 data-i18n="changePassword">
                Change Password
            </h1>
        </div>

        <p class="password-subtitle"
           data-i18n="changePasswordSubtitle">
            Update your password to keep your account secure.
        </p>

        <form id="changePasswordForm"
              method="post"
              action="@Url.Action("ChangePassword", "Account")">

            @Html.AntiForgeryToken()

            @{
                var fields = new[]
                {
                    new {
                        Id = "currentPassword",
                        Name = "CurrentPassword",
                        Key = "currentPassword",
                        Label = "Current Password",
                        AutoComplete = "current-password"
                    },
                    new {
                        Id = "newPassword",
                        Name = "NewPassword",
                        Key = "newPassword",
                        Label = "New Password",
                        AutoComplete = "new-password"
                    },
                    new {
                        Id = "confirmNewPassword",
                        Name = "ConfirmNewPassword",
                        Key = "confirmNewPassword",
                        Label = "Confirm New Password",
                        AutoComplete = "new-password"
                    }
                };
            }

            @foreach (var field in fields)
            {
                <div class="register-field">

                    <label for="@field.Id"
                           data-i18n="@field.Key">
                        @field.Label
                    </label>

                    <div class="register-password-wrapper">

                        <input type="password"
                               id="@field.Id"
                               name="@field.Name"
                               autocomplete="@field.AutoComplete"
                               maxlength="128"
                               required>

                        <button type="button"
                                class="register-password-toggle"
                                data-password-target="@field.Id"
                                aria-label="Show password">

                            <svg width="20"
                                 height="20"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.7">

                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/>

                                <circle cx="12"
                                        cy="12"
                                        r="3"/>

                            </svg>

                        </button>

                    </div>

                </div>
            }

            <div class="password-requirements">

                <h3 data-i18n="passwordRequirements">
                    Password Requirements
                </h3>

                <ul>
                    <li id="ruleLength"
                        data-i18n="passwordMinLength">
                        At least 8 characters
                    </li>

                    <li id="ruleUppercase"
                        data-i18n="passwordUppercase">
                        One uppercase letter
                    </li>

                    <li id="ruleLowercase"
                        data-i18n="passwordLowercase">
                        One lowercase letter
                    </li>

                    <li id="ruleNumber"
                        data-i18n="passwordNumber">
                        One number
                    </li>

                    <li id="ruleSpecial"
                        data-i18n="passwordSpecial">
                        One special character
                    </li>
                </ul>

            </div>

            <div asp-validation-summary="All"
                 class="text-danger"
                 role="alert">
            </div>

            <p id="changePasswordMessage"
               role="status"></p>

            <div class="profile-form-actions">

                <a href="/Account/MyAccount"
                   class="profile-cancel-button"
                   data-i18n="cancel">
                    Cancel
                </a>

                <button type="submit"
                        class="profile-save-button"
                        data-i18n="changePassword">
                    Change Password
                </button>

            </div>

        </form>

    </section>

</div>

@section Scripts {
    <script src="~/js/change-password.js"
            asp-append-version="true"></script>
}
