
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign In";
    ViewData["TitleKey"] = "signIn";
}

<div class="auth-card">

    <div class="auth-heading">

        <h1 data-i18n="signIn">
            Sign In
        </h1>

        <p data-i18n="welcome">
            Welcome back to SaigonBite!
        </p>

    </div>

    <form id="loginForm" method="post">

        <!-- Email or Phone -->

        <div class="form-group">

            <label for="identifier"
                   data-i18n="identifier">
                Email or Phone Number
            </label>

            <input type="text"
                   id="identifier"
                   name="identifier"
                   class="form-control auth-input"
                   data-i18n-placeholder="identifierPlaceholder"
                   placeholder="Enter email or phone number"
                   autocomplete="username"
                   required>

        </div>

        <!-- Password -->

        <div class="form-group">

            <label for="password"
                   data-i18n="password">
                Password
            </label>

            <div class="password-wrapper">

                <input type="password"
                       id="password"
                       name="password"
                       class="form-control auth-input"
                       data-i18n-placeholder="passwordPlaceholder"
                       placeholder="Enter your password"
                       autocomplete="current-password"
                       required>

                <button type="button"
                        class="password-toggle"
                        data-target="password"
                        data-i18n-aria="showPassword"
                        aria-label="Show password">

                    <svg width="22" height="22"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <path d="M2 12s3.6-7 10-7
                                 10 7 10 7-3.6 7-10 7
                                 -10-7-10-7Z"/>

                        <circle cx="12" cy="12" r="3"/>

                    </svg>

                </button>

            </div>

        </div>

        <!-- Login Options -->

        <div class="login-options">

            <label class="remember-me">

                <input type="checkbox"
                       name="rememberMe">

                <span data-i18n="rememberMe">
                    Remember me
                </span>

            </label>

            <a href="/Account/ForgotPassword"
                data-i18n="forgotPassword">
                Forgot Password?
            </a>

        </div>

        <!-- Sign In -->

        <button type="submit"
                class="auth-button"
                data-i18n="signIn">

            Sign In

        </button>

        <p id="loginMessage"
           class="login-message"
           role="status"></p>

    </form>

    <div class="auth-divider">

        <span data-i18n="or">OR</span>

    </div>

    <div class="register-section">

        <p data-i18n="noAccount">
            Don't have an account?
        </p>

        <a href="/Account/Register"
           class="outline-button"
           data-i18n="createAccount">

            Create New Account

        </a>

    </div>

    <a href="/"
       class="back-link"
       data-i18n="backPortal">

        &larr; Back to System Portal

    </a>

</div>
