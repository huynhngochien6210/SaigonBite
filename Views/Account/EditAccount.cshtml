
@model SaigonBite.ViewModels.EditAccountViewModel
@using SaigonBite.ViewModels
@using SaigonBite.Enums

@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Edit Account";

    var profile =
        (AccountProfileViewModel)ViewData["Profile"]!;

    bool isLocal =
        profile.AccountType == AccountType.LocalCustomer;
}

<div class="account-page">

    @await Html.PartialAsync("_AccountSidebar")

    <section class="account-content">

        <div class="profile-heading">

            <h1 data-i18n="editAccount">
                Edit Account
            </h1>

        </div>

        <h2 class="profile-section-title"
            data-i18n="personalInformation">

            Personal Information

        </h2>

        <form id="editProfileForm"
              method="post"
              action="@Url.Action("EditAccount", "Account")">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="text-danger"
                 role="alert">
            </div>

            <!-- Full Name -->
            <div class="register-field">

                <label for="editFullName"
                       data-i18n="fullName">
                    Full Name
                </label>

                <input asp-for="FullName"
                       type="text"
                       id="editFullName"
                       maxlength="100"
                       autocomplete="name"
                       required>

            </div>

            <!-- Email Address -->
            <div class="register-field">

                <label for="editEmail"
                       data-i18n="emailAddress">
                    Email Address
                </label>

                @if (isLocal)
                {
                    <input asp-for="Email"
                           type="email"
                           id="editEmail"
                           maxlength="254"
                           autocomplete="email">
                }
                else
                {
                    <input type="email"
                           id="editEmail"
                           value="@profile.Email"
                           readonly>

                    <small class="text-muted">
                        Login email cannot be changed here.
                    </small>
                }

            </div>

            <!-- Phone Number -->
            <div class="register-field">

                <label for="editPhone"
                       data-i18n="phoneNumber">
                    Phone Number
                </label>

                @if (isLocal)
                {
                    <input type="tel"
                           id="editPhone"
                           value="@profile.PhoneNumber"
                           readonly>

                    <small class="text-muted">
                        Login phone number cannot be changed here.
                    </small>
                }
                else
                {
                    <input asp-for="PhoneNumber"
                           type="tel"
                           id="editPhone"
                           maxlength="20"
                           autocomplete="tel">
                }

            </div>

            <!-- Date of Birth -->
            <div class="register-field">

                <label for="editDateOfBirth"
                       data-i18n="dateOfBirth">
                    Date of Birth
                </label>

                <input asp-for="DateOfBirth"
                       asp-format="{0:yyyy-MM-dd}"
                       type="date"
                       id="editDateOfBirth"
                       autocomplete="bday">

            </div>

            <!-- Foreign Tourist Information -->
            @if (!isLocal)
            {
                <div class="register-field">

                    <label for="editPassport"
                           data-i18n="passportNumber">
                        Passport Number
                    </label>

                    <input type="text"
                           id="editPassport"
                           value="@profile.PassportNumber"
                           readonly>

                    <small class="text-muted">
                        Passport number cannot be changed here.
                    </small>

                </div>

                <div class="register-field">

                    <label for="editNationality"
                           data-i18n="nationality">
                        Nationality
                    </label>

                    <input asp-for="Nationality"
                           type="text"
                           id="editNationality"
                           maxlength="100"
                           required>

                </div>
            }

            <p id="profileMessage"
               role="status">
            </p>

            <div class="profile-form-actions">

                <a href="/Account/MyAccount"
                   class="profile-cancel-button"
                   data-i18n="cancel">

                    Cancel

                </a>

                <button type="submit"
                        class="profile-save-button"
                        data-i18n="saveChanges">

                    Save Changes

                </button>

            </div>

        </form>

    </section>

</div>
