@model SaigonBite.ViewModels.ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset Password";
}

<div class="verification-card">

    <div class="verification-icon">

        <svg width="45" height="45"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="1.7">

            <path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11"/>

            <path d="m9 12 2 2 4-4"/>

        </svg>

    </div>

    <h1 data-i18n="resetPassword">
        Reset Password
    </h1>

    <p class="verification-description"
       data-i18n="resetPasswordDescription">
        Create a new password for your account.
    </p>

    <form id="resetPasswordForm"
        method="post"
        action="@Url.Action("ResetPassword", "Account")">

        @Html.AntiForgeryToken()

        <div class="register-field">

            <label for="newPassword"
                   data-i18n="newPassword">
                New Password
            </label>

            <div class="register-password-wrapper">

                <input type="password"
                       id="newPassword"
                       placeholder="Enter your new password"
                       data-i18n-placeholder="newPasswordPlaceholder"
                       autocomplete="new-password"
                       minlength="8"
                       required>

                <button type="button"
                        class="register-password-toggle"
                        data-toggle-password="newPassword"
                        aria-label="Show password">

                    <svg width="20" height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8">

                        <path d="M2 12s3.5-7 10-7
                                 10 7 10 7-3.5 7-10 7
                                 -10-7-10-7z"/>

                        <circle cx="12" cy="12" r="3"/>

                    </svg>

                </button>

            </div>

        </div>

        <div class="register-field">

            <label for="confirmNewPassword"
                   data-i18n="confirmPassword">
                Confirm Password
            </label>

            <div class="register-password-wrapper">

                <input type="password"
                       id="confirmNewPassword"
                       placeholder="Confirm your password"
                       data-i18n-placeholder="confirmPasswordPlaceholder"
                       autocomplete="new-password"
                       required>

                <button type="button"
                        class="register-password-toggle"
                        data-toggle-password="confirmNewPassword"
                        aria-label="Show password">

                    <svg width="20" height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8">

                        <path d="M2 12s3.5-7 10-7
                                 10 7 10 7-3.5 7-10 7
                                 -10-7-10-7z"/>

                        <circle cx="12" cy="12" r="3"/>

                    </svg>

                </button>

            </div>

        </div>

        <div class="password-requirements">

            <p data-i18n="passwordRequirements">
                Password requirements:
            </p>

            <ul>

                <li id="ruleLength"
                    data-i18n="ruleLength">
                    At least 8 characters
                </li>

                <li id="ruleUppercase"
                    data-i18n="ruleUppercase">
                    At least one uppercase letter
                </li>

                <li id="ruleLowercase"
                    data-i18n="ruleLowercase">
                    At least one lowercase letter
                </li>

                <li id="ruleNumber"
                    data-i18n="ruleNumber">
                    At least one number
                </li>

                <li id="ruleSpecial"
                    data-i18n="ruleSpecial">
                    At least one special character
                </li>

            </ul>

        </div>

        <p id="resetPasswordMessage"
           class="recovery-message"
           role="status"></p>

        <div asp-validation-summary="All"
            class="text-danger"
            role="alert">
        </div>

        <button type="submit"
                class="verification-button"
                data-i18n="resetPassword">
            Reset Password
        </button>

    </form>

    <a href="/Account/Login"
       class="verification-back"
       data-i18n="backToSignIn">
        ← Back to Sign In
    </a>


</div>

@section Scripts {
    <script src="~/js/forgot-password.js"
            asp-append-version="true"></script>
}