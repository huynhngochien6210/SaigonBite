
@model SaigonBite.ViewModels.AccountProfileViewModel
@using SaigonBite.Enums

@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "My Account";
}

<div class="account-page">

    @await Html.PartialAsync("_AccountSidebar")

    <section class="account-content">

        <div class="profile-heading">

            <h1 data-i18n="myAccount">
                My Account
            </h1>

            <a href="/Account/EditAccount"
               class="profile-edit-button">

                <svg width="18" height="18"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8">

                    <path d="m16 3 5 5-13 13H3v-5z"/>
                    <path d="m13 6 5 5"/>

                </svg>

                <span data-i18n="edit">
                    Edit
                </span>

            </a>

        </div>

        <h2 class="profile-section-title"
            data-i18n="personalInformation">

            Personal Information

        </h2>

        <div class="profile-fields">

            <!-- Full Name -->
            <div class="profile-field">

                <label data-i18n="fullName">
                    Full Name
                </label>

                <div class="profile-value"
                     id="displayFullName">

                    @Model.FullName

                </div>

            </div>

            <!-- Email -->
            <div class="profile-field">

                <label data-i18n="emailAddress">
                    Email Address
                </label>

                <div class="profile-value"
                     id="displayEmail">

                    @(Model.Email ?? "—")

                </div>

            </div>

            <!-- Phone Number -->
            <div class="profile-field">

                <label data-i18n="phoneNumber">
                    Phone Number
                </label>

                <div class="profile-value"
                     id="displayPhone">

                    @(Model.PhoneNumber ?? "—")

                </div>

            </div>

            <!-- Date of Birth -->
            <div class="profile-field">

                <label data-i18n="dateOfBirth">
                    Date of Birth
                </label>

                <div class="profile-value"
                     id="displayDateOfBirth">

                    @(Model.DateOfBirth?.ToString("yyyy-MM-dd") ?? "—")

                </div>

            </div>

            <!-- Foreign Tourist Information -->
            @if (Model.AccountType == AccountType.ForeignTourist)
            {
                <div class="profile-field">

                    <label data-i18n="passportNumber">
                        Passport Number
                    </label>

                    <div class="profile-value">

                        @(Model.PassportNumber ?? "—")

                    </div>

                </div>

                <div class="profile-field">

                    <label data-i18n="nationality">
                        Nationality
                    </label>

                    <div class="profile-value">

                        @(Model.Nationality ?? "—")

                    </div>

                </div>
            }

        </div>

        <!-- Verification Status -->
        <div class="profile-status">

            <span data-i18n="accountStatus">
                Account Status
            </span>

            @if (Model.IsVerified)
            {
                <strong data-i18n="verified">
                    ✓ Verified
                </strong>
            }
            else
            {
                <strong class="text-warning">
                    Unverified
                </strong>
            }

        </div>

        <!-- Success Message -->
        @if (TempData["ProfileSuccess"] != null)
        {
            <p class="profile-success-message"
               role="status">

                @TempData["ProfileSuccess"]

            </p>
        }
        <!-- Deactivate Account -->
        

            
    </section>

</div>
