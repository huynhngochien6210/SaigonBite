@{
    ViewData["Title"] = "Trạng thái đơn hàng";
}

<div class="sb-status-page">

    <h1 class="sb-status-title">Trạng thái đơn hàng</h1>

    <div class="sb-order-list">

        <!-- ORDER 1 -->
        <div class="sb-order-row">

            <div class="sb-order-info">
                <h2>#SB10245</h2>
                <p>20/10/2026 · 12:30</p>
            </div>

            <div class="sb-order-foods">
                <img src="~/image/com-tam.png" alt="Cơm tấm">
                <img src="~/image/banh-mi.png" alt="Bánh mì">
            </div>

            <div class="sb-order-status delivering">
                Đang giao
            </div>

            <div class="sb-order-right">
                <strong>122.000 ₫</strong>

                <a asp-controller="Order"
                   asp-action="Details"
                   class="sb-detail-btn">
                    Xem chi tiết
                    <span>→</span>
                </a>
            </div>

        </div>


        <!-- ORDER 2 -->
        <div class="sb-order-row">

            <div class="sb-order-info">
                <h2>#SB10231</h2>
                <p>19/10/2026 · 18:20</p>
            </div>

            <div class="sb-order-foods">
                <img src="~/image/com-tam.png" alt="Cơm tấm">
                <img src="~/image/banh-mi.png" alt="Bánh mì">
            </div>

            <div class="sb-order-status completed">
                Hoàn thành
            </div>

            <div class="sb-order-right">
                <strong>158.000 ₫</strong>

                <a asp-controller="Order"
                   asp-action="Details"
                   class="sb-detail-btn">
                    Xem chi tiết
                    <span>→</span>
                </a>
            </div>

        </div>


        <!-- ORDER 3 -->
        <div class="sb-order-row">

            <div class="sb-order-info">
                <h2>#SB10207</h2>
                <p>18/10/2026 · 12:05</p>
            </div>

            <div class="sb-order-foods">
                <img src="~/image/COD.png" alt="Bánh mì">
                <img src="~/image/COD.png" alt="Cơm tấm">
            </div>

            <div class="sb-order-status cancelled">
                Đã hủy
            </div>

            <div class="sb-order-right">
                <strong>95.000 ₫</strong>

                <a asp-controller="Order"
                   asp-action="Details"
                   class="sb-detail-btn">
                    Xem chi tiết
                    <span>→</span>
                </a>
            </div>

        </div>

    </div>

</div>