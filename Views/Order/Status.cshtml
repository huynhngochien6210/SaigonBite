@model List<SaigonBite.Models.Order>

@{
    ViewData["Title"] = "Trạng thái đơn hàng";
}

<div class="sb-status-page">

    <h1 class="sb-status-title">Trạng thái đơn hàng</h1>

    <div class="sb-order-list">
        @foreach (var order in Model)
        {
            <div class="sb-order-row">

                <div class="sb-order-info">
                    <h2>#@order.OrderId</h2>

                    <p>
                        @order.OrderTime.ToString("dd/MM/yyyy") ·
                        @order.OrderTime.ToString("HH:mm")
                    </p>
                </div>

                <div class="sb-order-foods">
                    @foreach (var item in order.OrderItems.Take(2))
                    {
                        <span>@item.ItemName</span>
                        @if (item != order.OrderItems.Take(2).Last())
                        {
                            <span>, </span>
                        }
                    }
                </div>

                <div class="sb-order-status">
                    @switch (order.Status)
                    {
                        case SaigonBite.Models.OrderStatus.Placed:
                            <text>Đã đặt</text>
                            break;

                        case SaigonBite.Models.OrderStatus.Confirmed:
                            <text>Đã xác nhận</text>
                            break;

                        case SaigonBite.Models.OrderStatus.Preparing:
                            <text>Đang chuẩn bị</text>
                            break;

                        case SaigonBite.Models.OrderStatus.Ready:
                            <text>Sẵn sàng</text>
                            break;

                        case SaigonBite.Models.OrderStatus.OutForDelivery:
                            <text>Đang giao</text>
                            break;

                        case SaigonBite.Models.OrderStatus.Delivered:
                            <text>Hoàn thành</text>
                            break;

                        case SaigonBite.Models.OrderStatus.Failed:
                            <text>Giao thất bại</text>
                            break;

                        case SaigonBite.Models.OrderStatus.Cancelled:
                            <text>Đã hủy</text>
                            break;
                    }
                </div>

                <div class="sb-order-right">
                    <strong>
                        @order.FinalTotal.ToString("N0") ₫
                    </strong>

                    <a asp-controller="Order"
                       asp-action="Details"
                       asp-route-id="@order.OrderId"
                       class="sb-detail-btn">
                        Xem chi tiết
                        <span>→</span>
                    </a>
                </div>

            </div>
        }
        

        

    </div>

</div>