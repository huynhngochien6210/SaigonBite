@{
    ViewData["Title"] = "Đặt hàng";
}

<div class="sb-order-page">

    <!-- Progress -->
    <div class="sb-order-progress">

        <div class="sb-step active">
            <div class="sb-step-number">1</div>
            <span>Đặt hàng</span>
        </div>

        <div class="sb-progress-line"></div>

        <div class="sb-step">
            <div class="sb-step-number">2</div>
            <span>Xác nhận</span>
        </div>

        <div class="sb-progress-line"></div>

        <div class="sb-step">
            <div class="sb-step-number">3</div>
            <span>Hoàn tất</span>
        </div>

    </div>

    <h1 class="sb-order-title">Đặt hàng</h1>

    <div class="sb-order-layout">

        <!-- LEFT -->
        <div class="sb-order-left">

            <!-- Thông tin giao hàng -->
            <div class="sb-order-card">

                <h2>Thông tin giao hàng</h2>

                <div class="sb-address-box">
                    <span class="sb-location-icon">📍</span>
                    <span>19 Nguyễn Trãi, Quận 1, TP. Hồ Chí Minh</span>
                </div>

                <label>Ghi chú (tùy chọn)</label>

                <textarea class="sb-note-input"
                          placeholder="Giao giờ trưa, xin cảm ơn!"></textarea>

            </div>

            <!-- Phương thức thanh toán -->
            <div class="sb-order-card">

                <h2>Phương thức thanh toán</h2>

                <div class="sb-payment-option selected">
                    <input type="radio"
                           name="payment"
                           checked />

                    <img src="~/image/cod.png"
                         alt="COD"
                         class="sb-payment-logo">

                    <span>Thanh toán khi nhận hàng (COD)</span>
                </div>

                <div class="sb-payment-option">
                    <input type="radio"
                           name="payment" />

                    <img src="~/image/momo.png"
                         alt="MoMo"
                         class="sb-payment-logo">

                    <span>MoMo</span>
                </div>

                <div class="sb-payment-option">
                    <input type="radio"
                           name="payment" />

                    <img src="~/image/vnpay.png"
                         alt="VNPay"
                         class="sb-payment-logo">

                    <span>VNPay</span>
                </div>

            </div>

        </div>

        <!-- RIGHT -->
        <div class="sb-order-summary">

            <h2>Tóm tắt đơn hàng</h2>

            <div class="sb-summary-row">
                <span>Tạm tính</span>
                <strong>127.000 ₫</strong>
            </div>

            <div class="sb-summary-row">
                <span>Voucher</span>
                <strong>−20.000 ₫ →</strong>
            </div>

            <div class="sb-summary-row">
                <span>Phí giao hàng</span>
                <strong>15.000 ₫</strong>
            </div>

            <div class="sb-summary-total">
                <span>Tổng thanh toán</span>
                <strong>122.000 ₫</strong>
            </div>

            <a asp-controller="Order"
               asp-action="Confirm"
               class="sb-continue-btn">
                Tiếp tục
                <span>→</span>
            </a>

        </div>

    </div>

</div>