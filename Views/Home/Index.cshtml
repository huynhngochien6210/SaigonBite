@{
    ViewData["Title"] = "Trang chủ";
}

<div class="saigonbite-home">

    <!-- HERO -->
    <section class="sb-hero">
    </section>


    <!-- FOOD SECTION -->
    <section class="sb-food-section">

        <h2>Món ngon Sài Gòn</h2>

        <!-- Categories -->
        <div class="sb-categories">

            <button class="sb-category active">
                <span class="category-icon">🍜</span>
                <span>Tất cả</span>
            </button>

            <button class="sb-category">
                <span class="category-icon">🍴</span>
                <span>Món chính</span>
            </button>

            <button class="sb-category">
                <span class="category-icon">🍲</span>
                <span>Món nước</span>
            </button>

            <button class="sb-category">
                <span class="category-icon">🍢</span>
                <span>Ăn vặt</span>
            </button>

            <button class="sb-category">
                <span class="category-icon">🥤</span>
                <span>Đồ uống</span>
            </button>

        </div>


        <!-- Food cards -->
        <div class="sb-food-grid">

            <!-- Card 1 -->
            <div class="sb-food-card">

                <div class="sb-food-image">
                    <div class="food-placeholder">🍚</div>
                    <button class="favorite">♡</button>
                </div>

                <div class="sb-food-info">
                    <h3>Cơm tấm Sài Gòn</h3>

                    <div class="sb-food-bottom">
                        <span class="sb-price">65.000 ₫</span>

                        <button class="sb-add-btn">
                            ＋ Thêm
                        </button>
                    </div>
                </div>

            </div>


            <!-- Card 2 -->
            <div class="sb-food-card">

                <div class="sb-food-image">
                    <div class="food-placeholder">🥖</div>
                    <button class="favorite">♡</button>
                </div>

                <div class="sb-food-info">
                    <h3>Bánh mì thịt</h3>

                    <div class="sb-food-bottom">
                        <span class="sb-price">35.000 ₫</span>

                        <button class="sb-add-btn">
                            ＋ Thêm
                        </button>
                    </div>
                </div>

            </div>


            <!-- Card 3 -->
            <div class="sb-food-card">

                <div class="sb-food-image">
                    <div class="food-placeholder">🍜</div>
                    <button class="favorite">♡</button>
                </div>

                <div class="sb-food-info">
                    <h3>Hủ tiếu Nam Vang</h3>

                    <div class="sb-food-bottom">
                        <span class="sb-price">62.000 ₫</span>

                        <button class="sb-add-btn">
                            ＋ Thêm
                        </button>
                    </div>
                </div>

            </div>


            <!-- Card 4 -->
            <div class="sb-food-card">

                <div class="sb-food-image">
                    <div class="food-placeholder">🥤</div>
                    <button class="favorite">♡</button>
                </div>

                <div class="sb-food-info">
                    <h3>Chè Sài Gòn</h3>

                    <div class="sb-food-bottom">
                        <span class="sb-price">28.000 ₫</span>

                        <button class="sb-add-btn">
                            ＋ Thêm
                        </button>
                    </div>
                </div>

            </div>

        </div>

    </section>

</div>
