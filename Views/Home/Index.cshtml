
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>SaigonBite System</title>

    <script src="/js/theme.js"></script>

    <link rel="stylesheet"
          href="/lib/bootstrap/dist/css/bootstrap.min.css">

    <link rel="stylesheet"
          href="/css/theme.css">

    <link rel="stylesheet"
          href="/css/portal.css">
</head>

<body>

    <!-- Logo -->
    <header class="brand-header">

    <img src="/images/brand-logo.jpg"
         alt="SaigonBite Logo">

    </header>

    <!-- Main Content -->
    <main class="container portal-container">

        <!-- Heading -->
        <section class="portal-heading text-center">

            <h1>SaigonBite System</h1>

            <p>
                Choose the appropriate interface to continue
            </p>

        </section>

        <!-- Interface Cards -->
        <div class="row g-4 justify-content-center">

            <!-- User Interface -->
            <div class="col-12 col-md-6">

                <div class="portal-card">

                    <img src="/images/customer.jpg"
                         class="portal-image"
                         alt="Customer">

                    <h2>User Interface</h2>

                    <p>
                        For customers to browse restaurants,
                        view menus, and manage their accounts.
                    </p>

                    <a href="/Account/Login"
                       class="btn access-button">

                        Access &nbsp; &rarr;

                    </a>

                </div>

            </div>

            <!-- Administrator Interface -->
            <div class="col-12 col-md-6">

                <div class="portal-card">

                    <img src="/images/admin.jpg"
                         class="portal-image"
                         alt="Administrator">

                    <h2>Administrator Interface</h2>

                    <p>
                        For administrators to manage the system,
                        restaurants, menus, orders, and accounts.
                    </p>

                    <a href="/Admin/Login"
                       class="btn access-button">

                        Access &nbsp; &rarr;

                    </a>

                </div>

            </div>

        </div>

    </main>

</body>
</html>
