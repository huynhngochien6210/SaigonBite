
@{
    ViewData["Title"] = "Dashboard";
}

<!-- HERO SECTION -->
<section class="dashboard-hero">

    <div class="hero-content">
        <h1>Dashboard quản lý</h1>
        <p>Tổng quan thương hiệu và món ăn</p>
    </div>

    <!-- Minh họa Chợ Bến Thành bằng CSS -->
    <div class="hero-art" aria-hidden="true">
        <div class="hero-tree tree-one"></div>
        <div class="hero-tree tree-two"></div>

        <div class="market-building">
            <div class="market-tower">
                <div class="market-clock">12</div>
                <div class="market-tower-roof"></div>
            </div>

            <div class="market-roof"></div>

            <div class="market-doors">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </div>

</section>


<!-- STATISTICS -->
<section class="statistics-grid">

    <div class="stat-card">
        <div class="stat-icon icon-brand">
            <svg viewBox="0 0 48 48" fill="none">
                <path d="M7 21L11 8H37L41 21"
                      stroke="currentColor"
                      stroke-width="3"/>
                <path d="M9 21V40H39V21"
                      stroke="currentColor"
                      stroke-width="3"/>
                <path d="M17 21V28H31V21"
                      stroke="currentColor"
                      stroke-width="3"/>
            </svg>
        </div>

        <div class="stat-info">
            <p>Tổng thương hiệu</p>
            <h2>12</h2>
        </div>
    </div>


    <div class="stat-card">
        <div class="stat-icon icon-food">
            <svg viewBox="0 0 48 48" fill="none">
                <path d="M13 29H35C35 37 30 41 24 41C18 41 13 37 13 29Z"
                      stroke="currentColor"
                      stroke-width="3"/>
                <path d="M9 29H39"
                      stroke="currentColor"
                      stroke-width="3"/>
                <path d="M19 20C13 14 22 12 19 6M28 20C22 14 31 12 28 6"
                      stroke="currentColor"
                      stroke-width="3"
                      stroke-linecap="round"/>
            </svg>
        </div>

        <div class="stat-info">
            <p>Tổng món ăn</p>
            <h2>256</h2>
        </div>
    </div>


    <div class="stat-card">
        <div class="stat-icon icon-active">
            <span>✓</span>
        </div>

        <div class="stat-info">
            <p>Đang hoạt động</p>
            <h2>238</h2>
        </div>
    </div>


    <div class="stat-card">
        <div class="stat-icon icon-unavailable">
            <span>⊘</span>
        </div>

        <div class="stat-info">
            <p>Hết bán</p>
            <h2>18</h2>
        </div>
    </div>

</section>


<!-- REPORTS -->
<section class="reports-grid">

    <!-- REPORT R1 -->
    <article class="report-card">

        <div class="report-illustration report-r1">
            <div class="report-label">R1</div>

            <div class="report-lines">
                <span></span>
                <span></span>
                <span></span>
            </div>

            <div class="report-chart">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
            </div>

            <div class="report-pie"></div>
        </div>

        <div class="report-content">
            <h3>Báo cáo R1 – Doanh thu</h3>

            <p>
                Xem thống kê doanh thu theo thời gian,
                nhóm thương hiệu và phương thức thanh toán.
            </p>

            <a asp-controller="Home"
               asp-action="ReportR1"
               class="report-button">
                Xem báo cáo R1 <span>→</span>
            </a>
        </div>

    </article>


    <!-- REPORT R2 -->
    <article class="report-card">

        <div class="report-illustration report-r2">
            <div class="report-label">R2</div>

            <div class="report-lines">
                <span></span>
                <span></span>
                <span></span>
            </div>

            <div class="report-chart">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
            </div>

            <div class="report-gauge">
                <div></div>
            </div>
        </div>

        <div class="report-content">
            <h3>Báo cáo R2 – Hiệu suất hub</h3>

            <p>
                Xem số đơn hàng, thời gian chuẩn bị trung bình,
                tải hub hiện tại và số lần áp dụng Quiet Kitchen.
            </p>

            <a asp-controller="Home"
               asp-action="ReportR2"
               class="report-button">
                Xem báo cáo R2 <span>→</span>
            </a>
        </div>

    </article>

</section>


<!-- RECENT ACTIVITIES -->
