@{
    ViewData["Title"] = "Trang chủ";
}

<div class="saigonbite-home">

    <!-- HERO -->
    <section class="sb-hero">
    </section>

    <!-- FOOD SECTION -->
    <section class="sb-food-section">

        <h2>Món ngon Sài Gòn</h2>

        <!-- Categories -->
        <div class="sb-categories">

            <button class="sb-category active">
                <span class="category-icon">🍜</span>
                <span>Tất cả</span>
            </button>

            <button class="sb-category">
                <span class="category-icon">🍴</span>
                <span>Món chính</span>
            </button>

            <button class="sb-category">
                <span class="category-icon">🍲</span>
                <span>Món nước</span>
            </button>

            <button class="sb-category">
                <span class="category-icon">🍢</span>
                <span>Ăn vặt</span>
            </button>

            <button class="sb-category">
                <span class="category-icon">🥤</span>
                <span>Đồ uống</span>
            </button>

        </div>


        <!-- Food cards -->
        <div class="sb-food-grid">

            <!-- Card 1 -->
            <div class="sb-food-card">

                <div class="sb-food-image">
                    <img src="~/image/cơm tấm long xuyên.png"
                         alt="Cơm tấm Long Xuyên" />
                </div>

                <div class="sb-food-info">

                    <h3>Cơm tấm Long Xuyên</h3>

                    <div class="sb-food-bottom">

                        <span class="sb-price">
                            35.000 ₫
                        </span>

                        <form asp-controller="Cart"
                              asp-action="Add"
                              method="post">

                            <input type="hidden"
                                   name="itemName"
                                   value="Cơm tấm Long Xuyên" />

                            <input type="hidden"
                                   name="unitPrice"
                                   value="35000" />

                            <button type="submit"
                                    class="sb-add-btn">
                                ＋ Thêm
                            </button>

                        </form>

                    </div>
                </div>
            </div>


            <!-- Card 2 -->
