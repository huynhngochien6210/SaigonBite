<!-- CATEGORY FILTER -->
<script>

    document.querySelectorAll(".sb-category").forEach(button => {

        button.addEventListener("click", function () {

            const filter = this.dataset.filter;

            // Active button
            document.querySelectorAll(".sb-category")
                .forEach(btn => {
                    btn.classList.remove("active");
                });

            this.classList.add("active");


            // Filter food cards
            document.querySelectorAll(".sb-food-card")
                .forEach(card => {

                    const category = card.dataset.category;

                    if (filter === "all" || category === filter) {
                        card.style.display = "";
                    }
                    else {
                        card.style.display = "none";
                    }

                });

        });

    });

</script>