                <tr>
                    <th>Thời gian</th>
                    <th>Nội dung</th>
                    <th>Loại</th>
                    <th>Người thực hiện</th>
                </tr>
            </thead>

            <tbody>

                <tr>
                    <td>20/10/2026 - 10:24</td>

                    <td>
                        <span class="activity-icon">🍲</span>
