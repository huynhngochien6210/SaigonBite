@model List<SaigonBite.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ hàng";
    decimal subtotal = Model.Sum(item => item.UnitPrice * item.Quantity);
}

<div class="sb-cart-page">

    <div class="sb-cart-heading">
        <a asp-controller="Home"
           asp-action="Index"
           class="sb-back-arrow">
            ←
        </a>

        <h1>Giỏ hàng</h1>
    </div>


    @if (!Model.Any())
    {
        <div class="sb-cart-empty">

            <h2>Giỏ hàng đang trống</h2>

            <p>
                Hãy chọn món ngon Sài Gòn mà bạn yêu thích nhé!
            </p>

            <a asp-controller="Home"
               asp-action="Index"
               class="sb-cart-back-btn">
                Xem món ăn
            </a>

        </div>
    }
    else
    {
        <div class="sb-cart-layout">

            <!-- DANH SÁCH MÓN -->
            <div class="sb-cart-items">

                @foreach (var item in Model)
                {
                    <div class="sb-cart-item">

                        <div class="sb-cart-item-info">

                            <h3>
                                @item.ItemName
                            </h3>

                            <span class="sb-cart-item-price">
                                @item.UnitPrice.ToString("N0") ₫
                            </span>

                        </div>


                        <div class="sb-cart-item-actions">

                            <!-- GIẢM -->
                            <form asp-controller="Cart"
                                  asp-action="Decrease"
                                  method="post">

                                <input type="hidden"
                                       name="itemName"
                                       value="@item.ItemName" />

                                <button type="submit"
                                        class="sb-quantity-btn">
                                    −
                                </button>

                            </form>


                            <!-- SỐ LƯỢNG -->
                            <span class="sb-cart-quantity">
                                @item.Quantity
                            </span>


                            <!-- TĂNG -->
                            <form asp-controller="Cart"
                                  asp-action="Increase"
                                  method="post">

                                <input type="hidden"
                                       name="itemName"
                                       value="@item.ItemName" />

                                <button type="submit"
                                        class="sb-quantity-btn">
                                    +
                                </button>

                            </form>


                            <!-- THÀNH TIỀN -->
                            <strong class="sb-cart-item-total">
                                @item.Total.ToString("N0") ₫
                            </strong>


                            <!-- XÓA -->
                            <form asp-controller="Cart"
                                  asp-action="Remove"
                                  method="post">

                                <input type="hidden"
                                       name="itemName"
                                       value="@item.ItemName" />

                                <button type="submit"
                                        class="sb-cart-remove">
                                    ×
                                </button>

                            </form>

                        </div>

                    </div>
                }

            </div>


            <!-- TỔNG TIỀN -->
            <div class="sb-cart-summary">

                <h2>Tóm tắt đơn hàng</h2>

                <div class="sb-cart-summary-row">

                    <span>Tạm tính</span>

                    <strong>
                        @subtotal.ToString("N0") ₫
                    </strong>

                </div>


                <div class="sb-cart-summary-row">

                    <span>Phí giao hàng</span>

                    <span>
                        15.000 ₫
                    </span>

                </div>


                <div class="sb-cart-summary-total">

                    <span>Tổng cộng</span>

                    <strong>
                        @((subtotal + 15000).ToString("N0")) ₫
                    </strong>

                </div>


                <a asp-controller="Order"
                   asp-action="Confirm"
                   class="sb-cart-checkout-btn">
                    Tiến hành đặt hàng
                </a>

            </div>

        </div>
    }

</div>
