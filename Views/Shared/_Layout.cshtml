<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SaigonBite</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SaigonBite.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="saigonbite-page">
    <header>
        <nav class="sb-navbar">
            <div class="sb-navbar-inner">

                <!-- Logo -->
                <a class="sb-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/image/Logo Chợ Bến Thành Cổ Điển.png" alt="SaigonBite">
                    <span>SaigonBite</span>
                </a>

                <!-- Navigation -->
                <div class="sb-nav-links">
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="sb-nav-link active">
                        Trang chủ
                    </a>

                    <a href="#" class="sb-nav-link">
                        Đơn hàng
                    </a>

                    <a href="#" class="sb-nav-link">
                        Trạng thái đơn hàng
                    </a>
                </div>

                <!-- Right -->
                <div class="sb-nav-right">

                    <a href="#" class="sb-cart">
                        🛒
                    </a>

                    <div class="sb-user">
                        <div class="sb-user-avatar">
                            👤
                        </div>

                        <span>Hiền</span>

                        <span class="sb-arrow">⌄</span>
                    </div>

                </div>

            </div>
        </nav>
    </header>
    <div>
        <main role="main">
            @RenderBody()
        </main>
    </div>
</div>
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SaigonBite - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
</body>
</html>
