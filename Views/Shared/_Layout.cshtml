<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SaigonBite</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SaigonBite.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="saigonbite-page">
    <header>
            <nav class="sb-navbar">

                <div class="sb-navbar-inner">

                    <!-- LOGO -->
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="sb-brand">

                        <img src="~/image/Logo Chợ Bến Thành Cổ Điển.png" alt="SaigonBite">

                        <span>SaigonBite</span>
                    </a>


                    <!-- MOBILE MENU BUTTON -->
                    <button class="sb-menu-toggle"
                            type="button"
                            onclick="toggleSbMenu()">
                        ☰
                    </button>


                    <!-- NAVIGATION -->
                    <div class="sb-nav-menu" id="sbNavMenu">

                        <div class="sb-nav-links">

                            <!-- TRANG CHỦ -->
                            <a asp-controller="Home"
                               asp-action="Index"
                               class="sb-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                                Trang chủ
                            </a>


                            <!-- ĐƠN HÀNG -->
                            <a asp-controller="Order"
                               asp-action="Confirm"
                               class="sb-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Confirm" || ViewContext.RouteData.Values["action"]?.ToString() == "Complete" ? "active" : "")">
                                Đơn hàng
                            </a>


                            <!-- TRẠNG THÁI -->
                            <a asp-controller="Order"
                               asp-action="Status"
                               class="sb-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Status" || ViewContext.RouteData.Values["action"]?.ToString() == "Details" ? "active" : "")">
                                Trạng thái đơn hàng
                            </a>

                        </div>


                        <!-- RIGHT -->
                        <div class="sb-nav-right">

                            <!-- CART -->
                            <a asp-controller="Cart"
                               asp-action="Index"
                               class="sb-cart">
                                🛒
                            </a>


                            <!-- USER -->
                            <div class="sb-user">

                                <div class="sb-user-avatar">
                                    👤
                                </div>

                                <span>Hiền</span>

                                <span class="sb-arrow">⌄</span>

                            </div>

                        </div>

                    </div>

                </div>

            </nav>
    </header>
    <div>
        <main role="main">
            @RenderBody()
        </main>
    </div>
</div>
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SaigonBite - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
    <script>
        function toggleSbMenu() {
            document
                .getElementById("sbNavMenu")
                .classList.toggle("show");
        }
    </script>

</body>
</html>
