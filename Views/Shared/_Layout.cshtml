
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SaigonBite</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Main CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- Razor CSS -->
    <link rel="stylesheet"
          href="~/SaigonBite.styles.css"
          asp-append-version="true" />
</head>

<body>

    <!-- HEADER -->
    <header class="site-header">

        <!-- LOGO -->
        <a class="brand-logo"
           asp-controller="Home"
           asp-action="Index">

            <img src="~/image/Logo Chợ Bến Thành Cổ Điển.png"
                 asp-append-version="true"
                 alt="SaigonBite Logo"
                 class="brand-logo-img" />

            <span>SaigonBite</span>

        </a>

        <!-- NAVIGATION -->
        <nav class="top-navigation">

            <a asp-controller="Home"
               asp-action="Index"
               class="nav-link active">
                Dashboard
            </a>

            <a asp-controller="Brand"
               asp-action="Index"
               class="nav-link">
                Quản lý thương hiệu
            </a>

            <a asp-controller="MenuItem"
               asp-action="Index"
               class="nav-link">
                Quản lý món ăn
            </a>

        </nav>

        <!-- ADMIN -->
        <div class="admin-profile">

            <div class="admin-avatar">
                <svg viewBox="0 0 24 24" fill="none">
                    <circle cx="12" cy="8" r="4"
                            fill="white"/>

                    <path d="M4 21C4 16.8 7.6 14 12 14C16.4 14 20 16.8 20 21"
                          fill="white"/>
                </svg>
            </div>

            <span>Admin</span>

            <span class="admin-chevron">⌄</span>

        </div>

    </header>

    <!-- MAIN CONTENT -->
    <main class="main-content">
        @RenderBody()
    </main>

    <!-- JAVASCRIPT -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
