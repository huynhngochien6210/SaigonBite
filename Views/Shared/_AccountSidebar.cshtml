@{
    string currentAction =
        ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool isProfile =
        currentAction == "MyAccount" ||
        currentAction == "EditAccount";
}

<aside class="account-sidebar">

    <div class="sidebar-user">

        <div class="profile-avatar">

            <svg width="48" height="48"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.5">

                <circle cx="12" cy="8" r="4"/>
                <path d="M4 22v-3a8 8 0 0 1 16 0v3"/>

            </svg>

        </div>

        <h3 id="sidebarFullName">
            Nguyen Van An
        </h3>

        <p id="sidebarAccountType"
           data-i18n="localCustomer">
            Local Customer
        </p>

    </div>

    <nav class="account-navigation">

        <a href="/Account/MyAccount"
           class="account-nav-item @(isProfile ? "active" : "")">

            <span data-i18n="myAccount">
                My Account
            </span>

        </a>

        <span class="account-nav-item pending"
              data-i18n="changePassword">
            Change Password
        </span>

        <span class="account-nav-item pending"
              data-i18n="loginHistory">
            Login History
        </span>

        <span class="account-nav-item pending"
              data-i18n="orderHistory">
            Order History
        </span>

        <hr>

        <a href="/Account/Login"
           id="demoSignOut"
           class="account-nav-item logout-link"
           data-i18n="signOut">

            Sign Out

        </a>

    </nav>

</aside>