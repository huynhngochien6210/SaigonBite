
@{
    string currentAction =
        ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool isProfile =
    currentAction == "MyAccount" ||
    currentAction == "EditAccount" ||
    currentAction == "DeactivateAccount";

    string fullName =
        User.Identity?.Name ?? "Customer";

    string accountType =
        User.FindFirst("AccountType")?.Value ?? "";

    bool isForeign =
        accountType == "ForeignTourist";
}

<aside class="account-sidebar">

    <div class="sidebar-user">

        <div class="profile-avatar">

            <svg width="48" height="48"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.5">

                <circle cx="12" cy="8" r="4"/>

                <path d="M4 22v-3a8 8 0 0 1 16 0v3"/>

            </svg>

        </div>

        <!-- Actual Customer Name -->
        <h3 id="sidebarFullName">

            @fullName

        </h3>

        <!-- Actual Account Type -->
        @if (isForeign)
        {
            <p id="sidebarAccountType"
               data-i18n="foreignTourist">

                Foreign Tourist

            </p>
        }
        else
        {
            <p id="sidebarAccountType"
               data-i18n="localCustomer">

                Local Customer

            </p>
        }

    </div>

    <nav class="account-navigation">

        <a href="/Account/MyAccount"
           class="account-nav-item @(isProfile ? "active" : "")"
           data-i18n="myAccount">

            My Account

        </a>

        <a href="/Account/ChangePassword"
           class="account-nav-item @(currentAction == "ChangePassword" ? "active" : "")"
           data-i18n="changePassword">

            Change Password

        </a>

        <a href="/Account/OrderHistory"
           class="account-nav-item @(currentAction == "OrderHistory" ? "active" : "")"
           data-i18n="orderHistory">

            Order History

        </a>

        <hr>

        <!-- Actual Logout -->
        <form method="post"
              action="@Url.Action("Logout", "Account")">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="account-nav-item logout-link w-100 text-start border-0 bg-transparent"
                    data-i18n="signOut">

                Sign Out

            </button>

        </form>

    </nav>

</aside>
