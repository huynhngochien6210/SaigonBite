<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SaigonBite</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/siteUC-D.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SaigonBite.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="saigonbite-page">
    <header>
            <nav class="sb-navbar">

                <div class="sb-navbar-inner">

                    <!-- LOGO -->
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="sb-brand">

                        <img src="~/image/Logo Chợ Bến Thành Cổ Điển.png" alt="SaigonBite">

                        <span>SaigonBite</span>
                    </a>


                    <!-- MOBILE MENU BUTTON -->
                    <button class="sb-menu-toggle"
                            type="button"
                            onclick="toggleSbMenu()">
                        ☰
                    </button>


                    <!-- NAVIGATION -->
                    <div class="sb-nav-menu" id="sbNavMenu">

                        <div class="sb-nav-links">

                            <!-- TRANG CHỦ -->
                            <a asp-controller="Home"
                               asp-action="Index"
                               class="sb-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                                Trang chủ
                            </a>


                            <!-- ĐƠN HÀNG -->
                            <a asp-controller="Order"
                               asp-action="Confirm"
                               class="sb-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Confirm" || ViewContext.RouteData.Values["action"]?.ToString() == "Complete" ? "active" : "")">
                                Đơn hàng
                            </a>


                            <!-- TRẠNG THÁI -->
                            <a asp-controller="Order"
                               asp-action="Status"
                               class="sb-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Status" || ViewContext.RouteData.Values["action"]?.ToString() == "Details" ? "active" : "")">
                                Trạng thái đơn hàng
                            </a>

                        </div>


                        <!-- RIGHT -->
                        <div class="sb-nav-right">

                            <!-- CART -->
                            <a asp-controller="Cart"
                               asp-action="Index"
                               class="sb-cart">
                                🛒
                            </a>


                            <!-- USER - UC-E Integration -->
                            <div class="sb-account-dropdown">
                                <button type="button"
                                        class="sb-account-toggle"
                                        onclick="toggleAccountMenu()"
                                        aria-controls="accountMenu"
                                        aria-expanded="false">
                                    <div class="sb-account-avatar">👤</div>
                                    <span class="sb-account-name">
                                        @(User.Identity?.IsAuthenticated == true
                                            ? (User.Identity.Name ?? "Tài khoản")
                                            : "Đăng nhập")
                                    </span>
                                </button>

                                <div class="sb-account-menu" id="accountMenu">
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        if (User.IsInRole("Customer"))
                                        {
                                            <a asp-controller="Account" asp-action="MyAccount">Tài khoản</a>
                                            <a asp-controller="Account" asp-action="OrderHistory">Lịch sử các đơn hàng</a>
                                        }
                                        <form asp-controller="Account"
                                              asp-action="Logout"
                                              method="post"
                                              asp-antiforgery="true"
                                              class="sb-account-logout-form">
                                            <button type="submit" class="sb-account-logout">Đăng xuất</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a asp-controller="Account" asp-action="Login">Đăng nhập</a>
                                        <a asp-controller="Account" asp-action="Register">Đăng ký</a>
                                    }
                                </div>
                            </div>

                        </div>

                    </div>

                </div>

            </nav>
    </header>
    <div>
        <main role="main">
            @RenderBody()
        </main>
    </div>
</div>
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SaigonBite - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
    <script>
        function toggleSbMenu() {
            document
                .getElementById("sbNavMenu")
                .classList.toggle("show");
        }
    </script>

    <script>
        function toggleAccountMenu() {
            const menu = document.getElementById("accountMenu");
            const isOpen = menu.classList.toggle("show");
            document.querySelector(".sb-account-toggle")
                .setAttribute("aria-expanded", String(isOpen));
        }
    </script>

</body>
</html>
