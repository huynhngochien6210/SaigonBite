@model SaigonBite.Models.Brand

@{
    ViewData["Title"] = "Xem thương hiệu";

    var activeFoods = Model.Foods?
        .Where(food => !food.IsDeleted)
        .OrderBy(food => food.FoodName)
        .ToList()
        ?? new List<SaigonBite.Models.Food>();
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin-brands.css"
          asp-append-version="true" />
}

<div class="view-brand-page">
    <section class="view-brand-banner"></section>

    <section class="view-brand-summary">
        <div class="view-brand-logo">
            @if (!string.IsNullOrWhiteSpace(Model.Logo))
            {
                <img src="@Url.Content(Model.Logo)"
                     alt="Logo @Model.BrandName"
                     style="width:100%;height:100%;object-fit:contain;border-radius:17px;" />
            }
            else
            {
                <span>🍛</span>
            }
        </div>

        <div class="view-brand-summary-content">
            <div class="view-brand-title-row">
                <h1>@Model.BrandName</h1>
                @if (Model.IsActive)
                {
                    <span class="view-brand-status">● Đang hoạt động</span>
                }
                else
                {
                    <span class="view-brand-status"
                          style="color:#ad271c;background:#fff0e9;">● Tạm dừng</span>
                }
            </div>

            <p class="view-brand-description">
                @(string.IsNullOrWhiteSpace(Model.Description)
                    ? "Thương hiệu chưa có mô tả."
                    : Model.Description)
            </p>

            <div class="view-brand-statistics">
                <div class="view-brand-stat">
                    <span class="view-brand-stat-icon">▦</span>
                    <strong>Ngày tạo:</strong>
                    <span>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="view-brand-stat">
                    <span class="view-brand-stat-icon">♧</span>
                    <strong>Số Hub:</strong>
                    <span>@Model.HubCount</span>
                </div>
                <div class="view-brand-stat">
                    <span class="view-brand-stat-icon">♜</span>
                    <strong>Số món ăn:</strong>
                    <span>@activeFoods.Count</span>
                </div>
            </div>
        </div>
    </section>

    <div class="view-brand-content">
        <section class="view-brand-panel">
            <h2>Thông tin thương hiệu</h2>
            <div class="view-brand-info-list">
                <div class="view-brand-info-row">
                    <strong>Mã thương hiệu</strong>
                    <span>@Model.BrandId</span>
                </div>
                <div class="view-brand-info-row">
                    <strong>Tên thương hiệu</strong>
                    <span>@Model.BrandName</span>
                </div>
                <div class="view-brand-info-row">
                    <strong>Mô tả ngắn</strong>
                    <span>
                        @(string.IsNullOrWhiteSpace(Model.Description)
                            ? "Chưa có mô tả."
                            : Model.Description)
                    </span>
                </div>
                <div class="view-brand-info-row">
                    <strong>Trạng thái</strong>
                    <span>
                        @if (Model.IsActive)
                        {
                            <span class="view-brand-status">● Đang hoạt động</span>
                        }
                        else
                        {
                            <span class="view-brand-status"
                                  style="color:#ad271c;background:#fff0e9;">● Tạm dừng</span>
                        }
                    </span>
                </div>
                <div class="view-brand-info-row">
                    <strong>Số Hub</strong>
                    <span>@Model.HubCount</span>
                </div>
                <div class="view-brand-info-row">
                    <strong>Ngày tạo</strong>
                    <span>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="view-brand-info-row">
                    <strong>Cập nhật lần cuối</strong>
                    <span>
                        @(Model.UpdatedAt.HasValue
                            ? Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")
                            : "Chưa cập nhật")
                    </span>
                </div>
            </div>
        </section>

        <section class="view-brand-panel">
            <h2>Món ăn thuộc thương hiệu</h2>
            <div class="view-brand-menu-table-wrapper">
                <table class="view-brand-menu-table">
                    <thead>
                        <tr>
                            <th>Món ăn</th>
                            <th>Danh mục</th>
                            <th>Giá bán</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (activeFoods.Any())
                        {
                            foreach (var food in activeFoods)
                            {
                                <tr>
                                    <td>
                                        <div class="view-brand-food">
                                            @if (!string.IsNullOrWhiteSpace(food.ImageUrl))
                                            {
                                                <img src="@Url.Content(food.ImageUrl)"
                                                     alt="@food.FoodName"
                                                     class="view-brand-food-image"
                                                     style="object-fit:cover;" />
                                            }
                                            else
                                            {
                                                <span class="view-brand-food-image">🍛</span>
                                            }
                                            <strong>@food.FoodName</strong>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="view-brand-category">@food.Category</span>
                                    </td>
                                    <td class="view-brand-price">
                                        @food.Price.ToString("N0") đ
                                    </td>
                                    <td>
                                        @if (food.IsAvailable)
                                        {
                                            <span class="view-brand-food-status">● Đang bán</span>
                                        }
                                        else
                                        {
                                            <span class="view-brand-food-status"
                                                  style="color:#ad271c;background:#fff0e9;">● Ngừng bán</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" style="text-align:center;padding:25px;">
                                    Thương hiệu này chưa có món ăn nào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <div class="view-brand-actions">
        <a asp-controller="Admin"
           asp-action="EditBrand"
           asp-route-id="@Model.BrandId"
           class="view-brand-back-button">
            <span>✎</span>
            Chỉnh sửa
        </a>

        <a asp-controller="Admin"
           asp-action="Brands"
           class="view-brand-back-button">
            <span>←</span>
            Quay lại
        </a>
    </div>
</div>
