@model IEnumerable<SaigonBite.Models.Brand>

@{
    ViewData["Title"] = "Quản lý thương hiệu";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin-brands.css"
          asp-append-version="true" />
}

<div class="brand-page">

    <!-- SUCCESS / ERROR MESSAGE -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- HERO -->
    <section class="brand-hero">
        <div class="brand-hero-content">
            <h1>Quản lý thương hiệu</h1>
            <p>
                Tạo, cập nhật và quản lý danh sách thương hiệu
                cùng số lượng hub đang liên kết.
            </p>
        </div>
    </section>

    <!-- SEARCH AND FILTER -->
    <section class="brand-toolbar">

        <div class="brand-search">
            <span class="search-icon">⌕</span>

            <input type="text"
                   id="brandSearch"
                   placeholder="Tìm kiếm thương hiệu theo tên, mô tả..." />
        </div>

        <div class="filter-group">
            <label for="statusFilter">Trạng thái:</label>

            <select id="statusFilter">
                <option value="all">Tất cả</option>
                <option value="active">Đang hoạt động</option>
                <option value="paused">Tạm dừng</option>
            </select>
        </div>

        <div class="filter-group hub-filter">
            <label for="hubFilter">Số hub:</label>

            <select id="hubFilter">
                <option value="all">Tất cả</option>
                <option value="3">3 hub</option>
                <option value="4">4 hub</option>
                <option value="6">6 hub</option>
                <option value="8">8 hub</option>
            </select>
        </div>

        <a asp-controller="Admin"
           asp-action="CreateBrand"
           class="add-brand-button">
            <span>＋</span>
            Thêm thương hiệu
        </a>
        <a asp-controller="Admin"
           asp-action="DeletedBrands"
           class="trash-brand-button">
            <span>🗑</span>
            Danh sách các thương hiệu đã xóa
        </a>

    </section>

    <!-- BRAND TABLE -->
    <section class="brand-table-card">

        <div class="table-scroll">

            <table class="brand-table" id="brandTable">

                <thead>
                    <tr>
                        <th class="logo-column">Logo</th>
                        <th class="name-column">Tên thương hiệu</th>
                        <th class="description-column">Mô tả ngắn</th>
                        <th class="hub-column">Số hub</th>
                        <th class="status-column">Trạng thái</th>
                        <th class="action-column">Thao tác</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var brand in Model)
                        {
                            <tr data-brand-id="@brand.BrandId"
                                data-status="@(brand.IsActive ? "active" : "paused")"
                                data-hub-count="@brand.HubCount"
                                data-dish-count="@(brand.Foods?.Count(f => !f.IsDeleted) ?? 0)"
                                data-order-count="0"
                                data-is-deleted="@brand.IsDeleted.ToString().ToLower()">

                                <!-- LOGO -->
                                <td>
                                    @{
                                        string logoPath =
                                            !string.IsNullOrWhiteSpace(brand.Logo)
                                            ? brand.Logo
                                            : brand.BrandName switch
                                            {
                                                "Bếp Việt" => "~/image/bepViet.png",
                                                "Góc Ăn Vặt" => "~/image/gocanvat.png",
                                                "Ẩm thực Sài Gòn" => "~/image/amthuc.png",
                                                _ => ""
                                            };
                                    }

                                    @if (!string.IsNullOrWhiteSpace(logoPath))
                                    {
                                        <img src="@Url.Content(logoPath)"
                                             alt="Logo @brand.BrandName"
                                             class="brand-thumbnail"
                                             style="object-fit: cover;"
                                             onerror="this.style.display='none';" />
                                    }
                                    else
                                    {
                                        <div class="brand-thumbnail food-rice">
                                            🍽️
                                        </div>
                                    }
                                </td>

                                <!-- BRAND NAME -->
                                <td class="brand-name-cell">
                                    @brand.BrandName
                                </td>

                                <!-- DESCRIPTION -->
                                <td>
                                    @(string.IsNullOrWhiteSpace(brand.Description)
                                        ? "Chưa có mô tả."
                                        : brand.Description)
                                </td>

                                <!-- HUB COUNT -->
                                <td class="hub-number">
                                    @brand.HubCount
                                </td>

                                <!-- STATUS -->
                                <td>
                                    @if (brand.IsActive)
                                    {
                                        <span class="brand-status status-active">
                                            Đang hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="brand-status status-paused">
                                            Tạm dừng
                                        </span>
                                    }
                                </td>

                                <!-- ACTIONS -->
                                <td>
                                    <div class="brand-actions">

                                        <a asp-controller="Admin"
                                           asp-action="ViewBrand"
                                           asp-route-id="@brand.BrandId"
                                           class="action-button">
                                            Xem
                                        </a>

                                        <a asp-controller="Admin"
                                           asp-action="EditBrand"
                                           asp-route-id="@brand.BrandId"
                                           class="action-button edit-button">
                                            ✎ Sửa
                                        </a>

                                        <button type="button"
                                                class="action-button delete-button"
                                                onclick="deleteBrand(this)">
                                            <span>▤</span> Xóa
                                        </button>

                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="no-brand-row">
                            <td colspan="6">
                                Chưa có thương hiệu nào. Hãy chọn
                                “Thêm thương hiệu” để tạo mới.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

            <div class="empty-brand-message"
                 id="emptyBrandMessage"
                 style="display: none;">
                Không tìm thấy thương hiệu phù hợp.
            </div>

        </div>

    </section>

    <!-- DELETE BRAND CONFIRMATION MODAL -->
    <div class="delete-brand-overlay" id="deleteBrandModal">

        <div class="delete-brand-modal">

            <!-- HEADER -->
            <div class="delete-modal-header">

                <div class="delete-modal-title">

                    <div class="delete-modal-icon">
                        <span>▤</span>
                    </div>

                    <h2 id="deleteModalHeading">
                        Xác nhận thao tác thương hiệu
                    </h2>

                </div>

                <button type="button"
                        class="delete-modal-close"
                        onclick="closeDeleteModal()">
                    ×
                </button>

            </div>

            <!-- WARNING BOX -->
            <div class="delete-warning-box">

                <span class="warning-icon">⚠</span>

                <div class="warning-message">

                    <strong id="deleteWarningTitle">
                        Thương hiệu có dữ liệu liên quan.
                    </strong>

                    <p id="deleteWarningDetails">
                        (0 món ăn, 0 đơn).
                    </p>

                </div>

            </div>

            <!-- DESCRIPTION -->
            <p class="delete-description">
                Hệ thống sẽ giữ lại dữ liệu món ăn, đơn hàng
                và lịch sử giao dịch có liên quan.
            </p>

            <!-- ACTION BUTTONS -->
            <div class="delete-modal-actions">

                <button type="button"
                        class="delete-cancel-button"
                        onclick="closeDeleteModal()">
                    Hủy
                </button>

                <button type="button"
                        class="delete-restore-button"
                        onclick="restoreBrand()">
                    <span>↶</span>
                    Khôi phục
                </button>

                <button type="button"
                        class="delete-confirm-button"
                        onclick="confirmDeleteBrand()">
                    Xác nhận
                    <span>→</span>
                </button>

            </div>

        </div>

    </div>

    <!-- FORM: PAUSE BRAND -->
    <form id="pauseBrandForm"
          asp-controller="Admin"
          asp-action="PauseBrand"
          method="post"
          style="display: none;">

        @Html.AntiForgeryToken()

        <input type="hidden"
               id="pauseBrandId"
               name="id" />

    </form>

    <!-- FORM: RESTORE BRAND -->
    <form id="restoreBrandForm"
          asp-controller="Admin"
          asp-action="RestoreBrand"
          method="post"
          style="display: none;">

        @Html.AntiForgeryToken()

        <input type="hidden"
               id="restoreBrandId"
               name="id" />

    </form>

    <!-- FORM: DELETE BRAND -->
    <form id="deleteBrandForm"
          asp-controller="Admin"
          asp-action="DeleteBrand"
          method="post"
          style="display: none;">

        @Html.AntiForgeryToken()

        <input type="hidden"
               id="deleteBrandId"
               name="id" />

    </form>

</div>

@section Scripts {

    <!-- LOAD BRAND MANAGEMENT JAVASCRIPT -->
    <script src="~/js/admin-brands.js"
            asp-append-version="true"></script>

    <!-- SEARCH AND FILTER HANDLER -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("brandSearch");

            const statusSelect =
                document.getElementById("statusFilter");

            const hubSelect =
                document.getElementById("hubFilter");

            const table =
                document.getElementById("brandTable");

            const emptyMessage =
                document.getElementById("emptyBrandMessage");

            if (!searchInput || !statusSelect ||
                !hubSelect || !table || !emptyMessage) {
                return;
            }

            function applyFilters() {

                const keyword = searchInput.value
                    .trim()
                    .toLocaleLowerCase("vi");

                const selectedStatus = statusSelect.value;
                const selectedHubCount = hubSelect.value;

                const rows = table.querySelectorAll(
                    "tbody tr[data-brand-id]"
                );

                let visibleCount = 0;

                rows.forEach(function (row) {

                    const rowStatus =
                        row.dataset.status || "";

                    const rowHubCount =
                        row.dataset.hubCount || "";

                    const rowText = row.innerText
                        .toLocaleLowerCase("vi");

                    const matchesKeyword =
                        rowText.includes(keyword);

                    const matchesStatus =
                        selectedStatus === "all" ||
                        rowStatus === selectedStatus;

                    const matchesHub =
                        selectedHubCount === "all" ||
                        rowHubCount === selectedHubCount;

                    const isVisible =
                        matchesKeyword &&
                        matchesStatus &&
                        matchesHub;

                    row.hidden = !isVisible;

                    if (isVisible) {
                        visibleCount++;
                    }

                });

                emptyMessage.style.display =
                    rows.length > 0 && visibleCount === 0
                        ? "block"
                        : "none";
            }

            searchInput.addEventListener("input", applyFilters);
            statusSelect.addEventListener("change", applyFilters);
            hubSelect.addEventListener("change", applyFilters);

            applyFilters();
        });
    </script>
}