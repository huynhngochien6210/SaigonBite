
@model SaigonBite.Models.Food

@{
    ViewData["Title"] = "Chi tiết món ăn";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin-foods.css"
          asp-append-version="true" />
}

<div class="view-food-page">

    <!-- BANNER -->
    <div class="view-food-banner"></div>

    <!-- BREADCRUMB -->
    <div style="margin: 15px 0 20px; font-size: 16px;">
        <a asp-controller="Admin"
           asp-action="Foods"
           style="color: #a51212; text-decoration: none;">
            Quản lý món ăn
        </a>
        <span> / </span>
        <strong>Chi tiết món ăn</strong>
    </div>

    <!-- FOOD DETAIL -->
    <section class="view-food-detail-card">

        <!-- FOOD IMAGE -->
        <div class="view-food-image">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl"
                     alt="@Model.FoodName"
                     class="food-main-image"
                     style="object-fit: cover;" />
            }
            else
            {
                <div class="food-main-image">
                    🍽️
                </div>
            }
        </div>

        <!-- MAIN INFORMATION -->
        <div class="view-food-main-info">

            <h1>@Model.FoodName</h1>

            <div class="food-info-row">
                <span class="food-info-icon">♧</span>
                <strong>Thương hiệu</strong>
                <span class="food-info-colon">:</span>
                <span>@(Model.Brand?.BrandName ?? "Chưa có thương hiệu")</span>
            </div>

            <div class="food-info-row">
                <span class="food-info-icon">▤</span>
                <strong>Danh mục</strong>
                <span class="food-info-colon">:</span>
                <span>@Model.Category</span>
            </div>

            <div class="food-info-row">
                <span class="food-info-icon">₫</span>
                <strong>Giá bán</strong>
                <span class="food-info-colon">:</span>
                <span class="view-food-price">
                    @Model.Price.ToString("N0") đ
                </span>
            </div>

            <div class="food-info-row">
                <span class="food-info-icon">●</span>
                <strong>Trạng thái</strong>
                <span class="food-info-colon">:</span>

                @if (Model.IsAvailable)
                {
                    <span class="food-status status-available">
                        <span>✓</span> Còn bán
                    </span>
                }
                else
                {
                    <span class="food-status status-unavailable">
                        <span>⊘</span> Hết bán
                    </span>
                }
            </div>

            <div class="food-info-row food-description-row">
                <span class="food-info-icon">☰</span>
                <strong>Mô tả</strong>
                <span class="food-info-colon">:</span>
                <span>
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "Chưa có mô tả cho món ăn này."
                        : Model.Description)
                </span>
            </div>

        </div>

        <!-- EXTRA INFORMATION -->
        <div class="view-food-extra-info">

            <div class="extra-info-section">
                <h3>Thông tin quản lý</h3>

                <div class="food-info-row">
                    <strong>Mã món ăn</strong>
                    <span class="food-info-colon">:</span>
                    <span>#@Model.FoodId</span>
                </div>

                <div class="food-info-row">
                    <strong>Ngày tạo</strong>
                    <span class="food-info-colon">:</span>
                    <span>@Model.CreatedAt.ToString("dd/MM/yyyy")</span>
                </div>

                <div class="food-info-row">
                    <strong>Cập nhật</strong>
                    <span class="food-info-colon">:</span>
                    <span>
                        @(Model.UpdatedAt.HasValue
                            ? Model.UpdatedAt.Value.ToString("dd/MM/yyyy")
                            : "Chưa cập nhật")
                    </span>
                </div>
            </div>

            <div class="extra-info-section">
                <h3>Trạng thái kinh doanh</h3>

                @if (Model.IsAvailable)
                {
                    <span class="food-status status-available">
                        ✓ Đang được kinh doanh
                    </span>
                }
                else
                {
                    <span class="food-status status-unavailable">
                        ⊘ Đang tạm ngừng bán
                    </span>
                }
            </div>

        </div>

    </section>

    <!-- ACTION BUTTONS -->
    <div class="view-food-bottom-actions">

        <a asp-controller="Admin"
           asp-action="Foods"
           class="view-food-back-button">
            <span>←</span> Quay lại danh sách
        </a>

    </div>

</div>
