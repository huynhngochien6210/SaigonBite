
@model SaigonBite.Models.Brand

@{
    ViewData["Title"] = "Chỉnh sửa thương hiệu";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin-brands.css"
          asp-append-version="true" />

    <style>
        .edit-brand-page {
            max-width: 1000px;
            margin: 0 auto;
            padding: 25px;
        }

        .edit-brand-card {
            background: #fff;
            border-radius: 16px;
            padding: 30px;
            box-shadow: 0 4px 18px rgba(0,0,0,.06);
        }

        .edit-brand-heading {
            margin-bottom: 25px;
        }

        .edit-brand-heading h1 {
            margin-bottom: 8px;
        }

        .edit-brand-form .form-group {
            margin-bottom: 22px;
        }

        .edit-brand-form label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .edit-brand-form input[type="text"],
        .edit-brand-form select,
        .edit-brand-form textarea {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font: inherit;
        }

        .edit-brand-form textarea {
            min-height: 120px;
            resize: vertical;
        }

        .current-brand-logo,
        .new-brand-logo-preview {
            width: 150px;
            height: 150px;
            object-fit: cover;
            border-radius: 12px;
            border: 1px solid #ddd;
            margin-top: 12px;
        }

        .new-brand-logo-preview {
            display: none;
        }

        .new-brand-logo-preview.show {
            display: block;
        }

        .edit-brand-error {
            display: block;
            color: #c0392b;
            margin-top: 6px;
            font-size: 14px;
        }

        .edit-brand-summary {
            color: #c0392b;
            margin-bottom: 15px;
        }

        .edit-brand-status {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .edit-brand-actions {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            margin-top: 30px;
        }

        .edit-brand-actions a,
        .edit-brand-actions button {
            padding: 12px 22px;
            border-radius: 8px;
            text-decoration: none;
            cursor: pointer;
            font: inherit;
        }

        .edit-brand-cancel {
            border: 1px solid #ccc;
            background: white;
            color: #333;
        }

        .edit-brand-save {
            border: none;
            background: #a83232;
            color: white;
        }
    </style>
}

<div class="edit-brand-page">

    <div class="edit-brand-heading">
        <h1>Chỉnh sửa thương hiệu</h1>
        <p>Cập nhật thông tin thương hiệu trong hệ thống SaigonBite.</p>
    </div>

    <div class="edit-brand-card">

        <form asp-controller="Admin"
              asp-action="EditBrand"
              asp-route-id="@Model.BrandId"
              method="post"
              enctype="multipart/form-data"
              class="edit-brand-form">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="BrandId" />

            <div asp-validation-summary="ModelOnly"
                 class="edit-brand-summary"></div>

            <!-- BRAND NAME -->
            <div class="form-group">
                <label asp-for="BrandName">
                    Tên thương hiệu <span>*</span>
                </label>

                <input asp-for="BrandName"
                       type="text"
                       placeholder="Nhập tên thương hiệu" />

                <span asp-validation-for="BrandName"
                      class="edit-brand-error"></span>
            </div>

            <!-- DESCRIPTION -->
            <div class="form-group">
                <label asp-for="Description">
                    Mô tả thương hiệu
                </label>

                <textarea asp-for="Description"
                          maxlength="500"
                          placeholder="Nhập mô tả thương hiệu..."></textarea>

                <span asp-validation-for="Description"
                      class="edit-brand-error"></span>
            </div>

            <!-- CURRENT LOGO -->
            <div class="form-group">
                <label>Logo hiện tại</label>

                @if (!string.IsNullOrWhiteSpace(Model.Logo))
                {
                    <img src="@Url.Content(Model.Logo)"
                         alt="Logo @Model.BrandName"
                         class="current-brand-logo" />
                }
                else
                {
                    <p>Thương hiệu chưa có logo.</p>
                }
            </div>

            <!-- NEW LOGO -->
            <div class="form-group">
                <label for="logoFile">Thay đổi logo</label>

                <input type="file"
                       id="logoFile"
                       name="logoFile"
                       accept=".jpg,.jpeg,.png" />

                <span asp-validation-for="Logo"
                      class="edit-brand-error"></span>

                <small>
                    Không chọn ảnh mới nếu muốn giữ logo hiện tại.
                    Chấp nhận JPG, JPEG, PNG, tối đa 5MB.
                </small>

                <img id="newLogoPreview"
                     class="new-brand-logo-preview"
                     alt="Xem trước logo mới" />
            </div>

            <!-- HUB COUNT -->
            <div class="form-group">
                <label asp-for="HubCount">Số Hub liên kết</label>

                <select asp-for="HubCount">
                    <option value="0">0 Hub</option>
                    <option value="3">3 Hub</option>
                    <option value="4">4 Hub</option>
                    <option value="6">6 Hub</option>
                    <option value="8">8 Hub</option>
                </select>

                <span asp-validation-for="HubCount"
                      class="edit-brand-error"></span>
            </div>

            <!-- STATUS -->
            <div class="form-group">
                <label>Trạng thái thương hiệu</label>

                <div class="edit-brand-status">
                    <input asp-for="IsActive"
                           type="checkbox" />

                    <label asp-for="IsActive" style="margin: 0;">
                        Hoạt động
                    </label>
                </div>
            </div>

            <!-- ACTIONS -->
            <div class="edit-brand-actions">

                <a asp-controller="Admin"
                   asp-action="Brands"
                   class="edit-brand-cancel">
                    Hủy
                </a>

                <button type="submit"
                        class="edit-brand-save">
                    Lưu thay đổi
                </button>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const logoInput = document.getElementById("logoFile");
            const preview = document.getElementById("newLogoPreview");

            if (!logoInput || !preview) return;

            logoInput.addEventListener("change", function () {

                const file = this.files[0];

                preview.classList.remove("show");
                preview.removeAttribute("src");

                if (!file) return;

                const allowedTypes = [
                    "image/jpeg",
                    "image/png"
                ];

                const maxSize = 5 * 1024 * 1024;

                if (!allowedTypes.includes(file.type)) {
                    alert("Chỉ chấp nhận ảnh JPG, JPEG hoặc PNG.");
                    this.value = "";
                    return;
                }

                if (file.size > maxSize) {
                    alert("Dung lượng ảnh không được vượt quá 5MB.");
                    this.value = "";
                    return;
                }

                const reader = new FileReader();

                reader.onload = function (event) {
                    preview.src = event.target.result;
                    preview.classList.add("show");
                };

                reader.readAsDataURL(file);
            });
        });
    </script>
}
