
@model SaigonBite.Models.Brand

@{
    ViewData["Title"] = "Thêm thương hiệu";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin-brands.css"
          asp-append-version="true" />

    <style>
        .create-brand-page {
            max-width: 1000px;
            margin: 0 auto;
            padding: 25px;
        }

        .create-brand-card {
            background: #fff;
            border-radius: 16px;
            padding: 30px;
            box-shadow: 0 4px 18px rgba(0,0,0,.06);
        }

        .create-brand-heading {
            margin-bottom: 25px;
        }

        .create-brand-heading h1 {
            margin-bottom: 8px;
        }

        .create-brand-form .form-group {
            margin-bottom: 22px;
        }

        .create-brand-form label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .create-brand-form input[type="text"],
        .create-brand-form input[type="number"],
        .create-brand-form textarea,
        .create-brand-form select {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font: inherit;
        }

        .create-brand-form textarea {
            min-height: 120px;
            resize: vertical;
        }

        .brand-logo-preview {
            display: none;
            width: 150px;
            height: 150px;
            object-fit: cover;
            border-radius: 12px;
            border: 1px solid #ddd;
            margin-top: 15px;
        }

        .brand-logo-preview.show {
            display: block;
        }

        .brand-form-error {
            display: block;
            color: #c0392b;
            margin-top: 6px;
            font-size: 14px;
        }

        .brand-form-summary {
            color: #c0392b;
            margin-bottom: 15px;
        }

        .brand-status-control {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .brand-form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            margin-top: 30px;
        }

        .brand-form-actions a,
        .brand-form-actions button {
            padding: 12px 22px;
            border-radius: 8px;
            text-decoration: none;
            cursor: pointer;
            font: inherit;
        }

        .brand-cancel-button {
            border: 1px solid #ccc;
            background: white;
            color: #333;
        }

        .brand-save-button {
            border: none;
            background: #a83232;
            color: white;
        }
    </style>
}

<div class="create-brand-page">

    <div class="create-brand-heading">
        <h1>Thêm thương hiệu mới</h1>
        <p>Nhập thông tin để tạo thương hiệu mới trong hệ thống SaigonBite.</p>
    </div>

    <div class="create-brand-card">

        <form asp-controller="Admin"
              asp-action="CreateBrand"
              method="post"
              enctype="multipart/form-data"
              class="create-brand-form">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="brand-form-summary"></div>

            <!-- BRAND NAME -->
            <div class="form-group">
                <label asp-for="BrandName">
                    Tên thương hiệu <span>*</span>
                </label>

                <input asp-for="BrandName"
                       type="text"
                       placeholder="Ví dụ: Bếp Việt" />

                <span asp-validation-for="BrandName"
                      class="brand-form-error"></span>
            </div>

            <!-- DESCRIPTION -->
            <div class="form-group">
                <label asp-for="Description">
                    Mô tả thương hiệu
                </label>

                <textarea asp-for="Description"
                          maxlength="500"
                          placeholder="Nhập mô tả ngắn về thương hiệu..."></textarea>

                <span asp-validation-for="Description"
                      class="brand-form-error"></span>
            </div>

            <!-- LOGO -->
            <div class="form-group">
                <label for="logoFile">
                    Logo thương hiệu <span>*</span>
                </label>

                <input type="file"
                       id="logoFile"
                       name="logoFile"
                       accept=".jpg,.jpeg,.png"
                       required />

                <span asp-validation-for="Logo"
                      class="brand-form-error"></span>

                <small>
                    Chấp nhận JPG, JPEG, PNG. Dung lượng tối đa 5MB.
                </small>

                <img id="logoPreview"
                     class="brand-logo-preview"
                     alt="Xem trước logo thương hiệu" />
            </div>

            <!-- HUB COUNT -->
            <div class="form-group">
                <label asp-for="HubCount">
                    Số Hub liên kết
                </label>

                <select asp-for="HubCount">
                    <option value="0">0 Hub</option>
                    <option value="3">3 Hub</option>
                    <option value="4">4 Hub</option>
                    <option value="6">6 Hub</option>
                    <option value="8">8 Hub</option>
                </select>

                <span asp-validation-for="HubCount"
                      class="brand-form-error"></span>

                <small>
                    Đây là số lượng Hub hiển thị. Danh sách Hub cụ thể
                    chưa được lưu thành quan hệ trong database.
                </small>
            </div>

            <!-- STATUS -->
            <div class="form-group">
                <label>Trạng thái thương hiệu</label>

                <div class="brand-status-control">
                    <input asp-for="IsActive"
                           type="checkbox" />

                    <label asp-for="IsActive" style="margin: 0;">
                        Hoạt động
                    </label>
                </div>
            </div>

            <!-- ACTIONS -->
            <div class="brand-form-actions">

                <a asp-controller="Admin"
                   asp-action="Brands"
                   class="brand-cancel-button">
                    Hủy
                </a>

                <button type="submit"
                        class="brand-save-button">
                    Lưu thương hiệu
                </button>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const logoInput = document.getElementById("logoFile");
            const preview = document.getElementById("logoPreview");

            if (!logoInput || !preview) return;

            logoInput.addEventListener("change", function () {

                const file = this.files[0];

                preview.classList.remove("show");
                preview.removeAttribute("src");

                if (!file) return;

                const allowedTypes = [
                    "image/jpeg",
                    "image/png"
                ];

                const maxSize = 5 * 1024 * 1024;

                if (!allowedTypes.includes(file.type)) {
                    alert("Chỉ chấp nhận ảnh JPG, JPEG hoặc PNG.");
                    this.value = "";
                    return;
                }

                if (file.size > maxSize) {
                    alert("Dung lượng ảnh không được vượt quá 5MB.");
                    this.value = "";
                    return;
                }

                const reader = new FileReader();

                reader.onload = function (event) {
                    preview.src = event.target.result;
                    preview.classList.add("show");
                };

                reader.readAsDataURL(file);
            });
        });
    </script>
}
