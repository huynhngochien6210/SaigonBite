
@{
    ViewData["Title"] = "Thêm thương hiệu";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin-brands.css"
          asp-append-version="true" />
}

<div class="create-brand-page">

    <!-- BACKGROUND IMAGE -->
    <section class="create-brand-banner">
        <!-- Không đặt heading hoặc category tabs tại đây -->
    </section>


    <!-- BRAND FORM -->
    <section class="create-brand-card">

        <form id="createBrandForm"
              enctype="multipart/form-data">

            <!-- BRAND NAME -->
            <div class="create-form-row">

                <label for="brandName">
                    Tên thương hiệu <span>*</span>
                </label>

                <div class="form-field">

                    <input type="text"
                           id="brandName"
                           name="BrandName"
                           placeholder="Nhập tên thương hiệu (ví dụ: Cơm tấm Sài Gòn)"
                           maxlength="100"
                           required />

                </div>

            </div>


            <!-- DESCRIPTION -->
            <div class="create-form-row">

                <label for="brandDescription">
                    Mô tả ngắn
                </label>

                <div class="form-field">

                    <textarea id="brandDescription"
                              name="Description"
                              maxlength="200"
                              rows="3"
                              placeholder="Nhập mô tả ngắn về thương hiệu (tối đa 200 ký tự)"></textarea>

                    <div class="character-count">
                        <span id="descriptionCount">0</span>/200 ký tự
                    </div>

                </div>

            </div>


            <!-- BRAND LOGO -->
            <div class="create-form-row">

                <label for="brandLogo">
                    Hình ảnh / Logo <span>*</span>
                </label>

                <div class="form-field">

                    <label for="brandLogo"
                           class="upload-box">

                        <div class="upload-icon">
                            <span>▧</span>
                        </div>

                        <div class="upload-text">

                            <strong>
                                Tải lên hình ảnh hoặc logo thương hiệu
                            </strong>

                            <p>
                                Định dạng: JPG, PNG. Dung lượng tối đa: 5MB.
                            </p>

                        </div>

                        <img id="logoPreview"
                             class="logo-preview"
                             alt="Logo xem trước" />

                    </label>

                    <input type="file"
                           id="brandLogo"
                           name="LogoFile"
                           accept=".jpg,.jpeg,.png"
                           hidden
                           required />

                    <span class="file-error"
                          id="fileError"></span>

                </div>

            </div>


            <!-- STATUS -->
            <div class="create-form-row">

                <label for="brandStatus">
                    Trạng thái <span>*</span>
                </label>

                <div class="form-field">

                    <label class="status-toggle">

                        <input type="checkbox"
                               id="brandStatus"
                               name="IsActive"
                               checked />

                        <span class="toggle-slider"></span>

                        <span class="toggle-status-text"
                              id="statusText">
                            Đang hoạt động
                        </span>

                    </label>

                </div>

            </div>


            <div class="form-divider"></div>


            <!-- HUB SELECTION -->
            <div class="create-form-row hub-create-row">

                <label>
                    Hub liên kết
                </label>

                <div class="form-field">

                    <button type="button"
                            class="choose-hub-button"
                            onclick="openHubModal()">

                        <span>＋</span>
                        Chọn hub liên kết

                    </button>

                    <div class="selected-hubs"
                         id="selectedHubs">

                        <span class="no-hub-text">
                            Chưa chọn Hub nào
                        </span>

                    </div>

                </div>

            </div>


            <div class="form-divider bottom-divider"></div>


            <!-- FORM ACTIONS -->
            <div class="create-form-actions">

                <a href="/Admin/Brands"
                   class="form-cancel-button">
                    Hủy
                </a>

                <button type="submit"
                        class="form-save-button">
                    Lưu
                </button>

            </div>

        </form>

    </section>

</div>


<!-- HUB SELECTION MODAL -->
<div class="hub-modal-overlay" id="hubModal">

    <div class="hub-modal">

        <!-- HEADER -->
        <div class="hub-modal-header">

            <h2>Chọn hub liên kết</h2>

            <button type="button"
                    class="hub-modal-close"
                    onclick="closeHubModal()">
                ×
            </button>

        </div>


        <!-- HUB LIST -->
        <div class="hub-list">

            <!-- HUB 1 -->
            <label class="hub-option">

                <input type="checkbox"
                       value="H1"
                       data-name="Hub Quận 1"
                       checked />

                <span class="hub-checkbox"></span>

                <span class="hub-location-icon">♧</span>

                <span class="hub-information">
                    <strong>Hub Quận 1</strong>
                    <small>
                        19 Nguyễn Thái Bình, Quận 1, TP. Hồ Chí Minh
                    </small>
                </span>

            </label>


            <!-- HUB 2 -->
            <label class="hub-option">

                <input type="checkbox"
                       value="H2"
                       data-name="Hub Quận 2" />

                <span class="hub-checkbox"></span>

                <span class="hub-location-icon">♧</span>

                <span class="hub-information">
                    <strong>Hub Quận 2</strong>
                    <small>
                        215 Trần Não, TP. Thủ Đức, TP. Hồ Chí Minh
                    </small>
                </span>

            </label>


            <!-- HUB 3 -->
            <label class="hub-option">

                <input type="checkbox"
                       value="H3"
                       data-name="Hub Quận 3"
                       checked />

                <span class="hub-checkbox"></span>

                <span class="hub-location-icon">♧</span>

                <span class="hub-information">
                    <strong>Hub Quận 3</strong>
                    <small>
                        182 Võ Văn Tần, Quận 3, TP. Hồ Chí Minh
                    </small>
                </span>

            </label>


            <!-- HUB 10 -->
            <label class="hub-option">

                <input type="checkbox"
                       value="H10"
                       data-name="Hub Quận 10" />

                <span class="hub-checkbox"></span>

                <span class="hub-location-icon">♧</span>

                <span class="hub-information">
                    <strong>Hub Quận 10</strong>
                    <small>
                        455 Sư Vạn Hạnh, Quận 10, TP. Hồ Chí Minh
                    </small>
                </span>

            </label>

        </div>


        <!-- MODAL ACTIONS -->
        <div class="hub-modal-actions">

            <button type="button"
                    class="hub-close-button"
                    onclick="closeHubModal()">
                Đóng
            </button>

            <button type="button"
                    class="hub-save-button"
                    onclick="saveSelectedHubs()">
                Lưu
            </button>

        </div>

    </div>

</div>


@section Scripts {

    <script src="~/js/admin-brands.js"
            asp-append-version="true"></script>
}
