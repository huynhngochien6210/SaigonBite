
@model SaigonBite.Models.Food
@using SaigonBite.Models

@{
    ViewData["Title"] = "Sửa món ăn";

    var foodId = Model.FoodId;
    var categories = new[]
    {
        "Món chính",
        "Món nước",
        "Ăn vặt",
        "Đồ uống"
    };
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin-foods.css"
          asp-append-version="true" />
}

<div class="edit-food-page">

    <section class="edit-food-card">

        <div class="edit-food-heading">
            <div>
                <h1>Chỉnh sửa món ăn</h1>
                <p>Cập nhật thông tin và trạng thái kinh doanh của món ăn.</p>
            </div>

            <span class="edit-food-id">
                Mã món: FD-@foodId
            </span>
        </div>

        <form id="editFoodForm"
              asp-controller="Admin"
              asp-action="EditFood"
              asp-route-id="@Model.FoodId"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="FoodId" />

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary"></div>

            <!-- TÊN MÓN ĂN -->
            <div class="edit-food-row">
                <label asp-for="FoodName">
                    Tên món ăn <span>*</span>
                </label>

                <div class="edit-food-field">
                    <input asp-for="FoodName"
                           id="editFoodName"
                           maxlength="150"
                           required />

                    <span asp-validation-for="FoodName"
                          class="field-error"></span>
                </div>
            </div>

            <!-- THƯƠNG HIỆU -->
            <div class="edit-food-row">
                <label asp-for="BrandId">
                    Thương hiệu <span>*</span>
                </label>

                <div class="edit-food-field">
                    <select asp-for="BrandId"
                            id="editFoodBrand"
                            required>

                        <option value="">-- Chọn thương hiệu --</option>

                        @if (ViewBag.Brands != null)
                        {
                            foreach (Brand brand in ViewBag.Brands)
                            {
                                <option value="@brand.BrandId">
                                    @brand.BrandName
                                </option>
                            }
                        }
                    </select>

                    <span asp-validation-for="BrandId"
                          class="field-error"></span>
                </div>
            </div>

            <!-- DANH MỤC -->
            <div class="edit-food-row">
                <label asp-for="Category">
                    Danh mục <span>*</span>
                </label>

                <div class="edit-food-field">
                    <select asp-for="Category"
                            id="editFoodCategory"
                            required>

                        <option value="">-- Chọn danh mục --</option>

                        @foreach (var category in categories)
                        {
                            <option value="@category">
                                @category
                            </option>
                        }
                    </select>

                    <span asp-validation-for="Category"
                          class="field-error"></span>
                </div>
            </div>

            <!-- GIÁ BÁN -->
            <div class="edit-food-row">
                <label asp-for="Price">
                    Giá bán (VNĐ) <span>*</span>
                </label>

                <div class="edit-food-field">
                    <input asp-for="Price"
                           id="editFoodPrice"
                           type="number"
                           min="1000"
                           max="999999999"
                           step="1000"
                           required />

                    <span asp-validation-for="Price"
                          class="field-error"></span>
                </div>
            </div>

            <!-- MÔ TẢ -->
            <div class="edit-food-row">
                <label asp-for="Description">
                    Mô tả món ăn
                </label>

                <div class="edit-food-field">
                    <textarea asp-for="Description"
                              id="editFoodDescription"
                              rows="3"
                              maxlength="1000"></textarea>

                    <span asp-validation-for="Description"
                          class="field-error"></span>
                </div>
            </div>

            <!-- HÌNH ẢNH -->
            <div class="edit-food-row">
                <label>Hình ảnh món ăn</label>

                <div class="edit-food-field">

                    <div class="edit-food-image-area">

                        <div class="edit-food-current-image"
                             id="editFoodImageBox">

                            <span id="editFoodImageEmoji"
                                  style="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "" : "display:none;")">
                                🍛
                            </span>

                            <img id="editFoodImagePreview"
                                 src="@Model.ImageUrl"
                                 alt="Ảnh món ăn hiện tại"
                                 style="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "display:none;" : "display:block;")" />
                        </div>

                        <label for="editFoodImage"
                               class="edit-food-upload-button">

                            <span>📷</span>
                            <strong>Thay đổi hình ảnh</strong>
                            <small>JPG, JPEG, PNG hoặc WEBP, tối đa 5MB</small>
                        </label>

                        <input type="file"
                               id="editFoodImage"
                               name="imageFile"
                               accept=".jpg,.jpeg,.png,.webp"
                               hidden />
                    </div>

                    <small class="edit-food-note"
                           id="editFoodImageError"></small>

                    <small id="editFoodFileName">
                        Giữ ảnh hiện tại nếu không chọn ảnh mới.
                    </small>
                </div>
            </div>

            <!-- TRẠNG THÁI -->
            <div class="edit-food-row">
                <label asp-for="IsAvailable">
                    Trạng thái kinh doanh
                </label>

                <div class="edit-food-field">
                    <select asp-for="IsAvailable"
                            id="editFoodStatus"
                            class="edit-food-status-select">

                        <option value="true">Đang kinh doanh</option>
                        <option value="false">Tạm ngừng kinh doanh</option>
                    </select>

                    <span asp-validation-for="IsAvailable"
                          class="field-error"></span>
                </div>
            </div>

            <div class="edit-food-divider"></div>

            <!-- BUTTONS -->
            <div class="edit-food-actions">

                <a asp-controller="Admin"
                   asp-action="Foods"
                   class="edit-food-cancel-button">
                    Hủy
                </a>

                <button type="submit"
                        class="edit-food-save-button">
                    <span>✓</span> Lưu thay đổi
                </button>

            </div>

        </form>
    </section>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const imageInput =
                document.getElementById("editFoodImage");

            const imagePreview =
                document.getElementById("editFoodImagePreview");

            const imageEmoji =
                document.getElementById("editFoodImageEmoji");

            const imageError =
                document.getElementById("editFoodImageError");

            const fileName =
                document.getElementById("editFoodFileName");

            const form =
                document.getElementById("editFoodForm");

            const maxFileSize = 5 * 1024 * 1024;

            const allowedTypes = [
                "image/jpeg",
                "image/png",
                "image/webp"
            ];

            let previewUrl = null;

            imageInput.addEventListener("change", function () {

                imageError.textContent = "";

                const file = this.files[0];

                if (!file) {
                    return;
                }

                if (!allowedTypes.includes(file.type)) {
                    imageError.textContent =
                        "Chỉ chấp nhận ảnh JPG, JPEG, PNG hoặc WEBP.";

                    this.value = "";
                    return;
                }

                if (file.size > maxFileSize) {
                    imageError.textContent =
                        "Dung lượng ảnh không được vượt quá 5MB.";

                    this.value = "";
                    return;
                }

                if (previewUrl) {
                    URL.revokeObjectURL(previewUrl);
                }

                previewUrl = URL.createObjectURL(file);

                imagePreview.src = previewUrl;
                imagePreview.style.display = "block";

                imageEmoji.style.display = "none";

                fileName.textContent =
                    "Ảnh mới: " + file.name;
            });

            form.addEventListener("submit", function (event) {

                const file = imageInput.files[0];

                if (!file) {
                    return;
                }

                if (!allowedTypes.includes(file.type) ||
                    file.size > maxFileSize) {

                    event.preventDefault();

                    imageError.textContent =
                        "Vui lòng chọn ảnh hợp lệ, dung lượng tối đa 5MB.";
                }
            });

        });
    </script>
}
