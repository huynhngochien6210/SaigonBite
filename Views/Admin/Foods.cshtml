
@model List<SaigonBite.Models.Food>
@using SaigonBite.Models

@{
    ViewData["Title"] = "Quản lý món ăn";
    var totalFoods = Model?.Count ?? 0;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin-foods.css"
          asp-append-version="true" />
}

<div class="food-page">

    <!-- BANNER -->
    <section class="food-hero">
        <div class="food-hero-content">
            <h1>Quản lý món ăn</h1>
            <p>Tạo, cập nhật, xóa món ăn và quản lý trạng thái bán.</p>
        </div>
    </section>

    <!-- SEARCH AND FILTER -->
    <section class="food-toolbar">

        <!-- SEARCH -->
        <div class="food-search">
            <span class="search-icon">⌕</span>
            <input type="text"
                   id="foodSearch"
                   placeholder="Tìm kiếm món ăn theo tên..."
                   autocomplete="off" />
        </div>

        <!-- BRAND FILTER -->
        <div class="food-filter">
            <label for="brandFilter">Thương hiệu</label>

            <select id="brandFilter">
                <option value="all">Tất cả thương hiệu</option>

                @if (ViewBag.Brands != null)
                {
                    foreach (Brand brand in ViewBag.Brands)
                    {
                        <option value="@brand.BrandName">
                            @brand.BrandName
                        </option>
                    }
                }
            </select>
        </div>

        <!-- CATEGORY FILTER -->
        <div class="food-filter">
            <label for="categoryFilter">Danh mục</label>

            <select id="categoryFilter">
                <option value="all">Tất cả danh mục</option>
                <option value="Món chính">Món chính</option>
                <option value="Món nước">Món nước</option>
                <option value="Ăn vặt">Ăn vặt</option>
                <option value="Đồ uống">Đồ uống</option>
            </select>
        </div>

        <!-- STATUS FILTER -->
        <div class="food-filter">
            <label for="statusFilter">Trạng thái</label>

            <select id="statusFilter">
                <option value="all">Tất cả trạng thái</option>
                <option value="available">Còn bán</option>
                <option value="unavailable">Hết bán</option>
            </select>
        </div>

        <!-- ADD FOOD -->
        <a asp-controller="Admin"
           asp-action="CreateFood"
           class="add-food-button">
            <span>＋</span>
            Thêm món ăn
        </a>

    </section>

    <!-- FOOD TABLE -->
    <section class="food-table-card">

        <div class="food-table-scroll">

            <table class="food-table" id="foodTable">

                <thead>
                    <tr>
                        <th class="image-column">Hình ảnh</th>
                        <th>Tên món</th>
                        <th>Thương hiệu</th>
                        <th>Danh mục</th>
                        <th>Giá bán</th>
                        <th>Trạng thái</th>
                        <th class="action-column">Thao tác</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var food in Model)
                        {
                            var status = food.IsAvailable
                                ? "available"
                                : "unavailable";

                            var categoryClass = food.Category switch
                            {
                                "Món chính" => "category-main",
                                "Món nước" => "category-soup",
                                "Ăn vặt" => "category-snack",
                                "Đồ uống" => "category-drink",
                                _ => "category-main"
                            };

                            var brandName = food.Brand?.BrandName
                                ?? "Chưa có thương hiệu";

                            <tr data-id="@food.FoodId"
                                data-brand="@brandName"
                                data-category="@food.Category"
                                data-status="@status">

                                <!-- IMAGE -->
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(food.ImageUrl))
                                    {
                                        <img src="@food.ImageUrl"
                                             alt="@food.FoodName"
                                             class="food-image"
                                             style="object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="food-image">🍽️</div>
                                    }
                                </td>

                                <!-- FOOD NAME -->
                                <td class="food-name">
                                    @food.FoodName
                                </td>

                                <!-- BRAND -->
                                <td>
                                    <span class="food-brand">♧</span>
                                    @brandName
                                </td>

                                <!-- CATEGORY -->
                                <td>
                                    <span class="category-tag @categoryClass">
                                        @food.Category
                                    </span>
                                </td>

                                <!-- PRICE -->
                                <td class="food-price">
                                    @food.Price.ToString("N0") đ
                                </td>

                                <!-- STATUS -->
                                <td>
                                    @if (food.IsAvailable)
                                    {
                                        <span class="food-status status-available">
                                            <span>✓</span> Còn bán
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="food-status status-unavailable">
                                            <span>⊘</span> Hết bán
                                        </span>
                                    }
                                </td>

                                <!-- ACTIONS -->
                                <td>
                                    <div class="food-actions">

                                        <a asp-controller="Admin"
                                           asp-action="ViewFood"
                                           asp-route-id="@food.FoodId"
                                           class="food-action view-action">
                                            <span>◎</span> Xem
                                        </a>

                                        <a asp-controller="Admin"
                                           asp-action="EditFood"
                                           asp-route-id="@food.FoodId"
                                           class="food-action edit-action">
                                            <span>✎</span> Sửa
                                        </a>

                                        <button type="button"
                                                class="food-action delete-action"
                                                data-id="@food.FoodId"
                                                onclick="deleteFood(this)">
                                            <span>▤</span> Xóa
                                        </button>

                                    </div>
                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

            <!-- EMPTY MESSAGE -->
            <div class="empty-food-message"
                 id="emptyFoodMessage"
                 style="@(totalFoods > 0 ? "display:none;" : "display:block;")">

                @(totalFoods > 0
                    ? "Không tìm thấy món ăn phù hợp."
                    : "Chưa có món ăn nào trong hệ thống.")

            </div>

        </div>
    </section>

    <!-- PAGINATION / FOOD COUNT -->
    <div class="food-pagination">

        <span id="foodCount">
            Hiển thị @totalFoods món ăn
        </span>

        <div class="pagination-buttons">
            <button type="button" disabled>‹</button>
            <button type="button" class="current-page">1</button>
            <button type="button" disabled>›</button>
        </div>

    </div>

</div>


<!-- =================================================
     DELETE FOOD CONFIRMATION POPUP
================================================== -->

<div class="food-delete-overlay" id="deleteFoodModal">

    <div class="food-delete-modal">

        <!-- POPUP HEADER -->
        <div class="food-delete-header">

            <div class="food-delete-title">
                <div class="food-delete-icon">▤</div>
                <h2>Xác nhận xóa món ăn</h2>
            </div>

            <button type="button"
                    class="food-delete-close"
                    onclick="closeDeleteFoodModal()"
                    aria-label="Đóng popup">
                ×
            </button>

        </div>

        <!-- WARNING -->
        <div class="food-delete-warning">

            <span class="food-delete-warning-icon">⚠</span>

            <div>
                <strong id="foodDeleteWarningTitle">
                    Món ăn có dữ liệu liên quan.
                </strong>

                <p id="foodDeleteWarningDetails">
                    (0 đơn hàng).
                </p>
            </div>

        </div>

        <!-- DESCRIPTION -->
        <p class="food-delete-description" id="foodDeleteDescription">
            Hệ thống sẽ ngừng kinh doanh món ăn này thay vì xóa vĩnh viễn,
            nhằm giữ lại dữ liệu đơn hàng và lịch sử giao dịch có liên quan.
        </p>

        <!-- ACTION BUTTONS -->
        <div class="food-delete-actions">

            <button type="button"
                    class="food-delete-cancel"
                    onclick="closeDeleteFoodModal()">
                Hủy
            </button>

            <button type="button"
                    class="food-delete-restore"
                    id="restoreFoodButton"
                    onclick="restoreFood()"
                    style="display: none;">
                <span>↶</span> Khôi phục
            </button>

            <button type="button"
                    class="food-delete-confirm"
                    id="confirmFoodDeleteButton"
                    onclick="confirmDeleteFood()">
                Xác nhận xóa <span>→</span>
            </button>

        </div>

    </div>
</div>


@section Scripts {

    <script src="~/js/admin-foods.js"
            asp-append-version="true"></script>

    <!-- SEARCH AND FILTER HANDLER -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const searchInput = document.getElementById("foodSearch");
            const brandFilter = document.getElementById("brandFilter");
            const categoryFilter = document.getElementById("categoryFilter");
            const statusFilter = document.getElementById("statusFilter");

            const foodTable = document.getElementById("foodTable");
            const emptyMessage = document.getElementById("emptyFoodMessage");
            const foodCount = document.getElementById("foodCount");

            if (!foodTable) return;

            const rows = Array.from(
                foodTable.querySelectorAll("tbody tr")
            );

            const totalRows = rows.length;

            // Chuẩn hóa chuỗi để tìm kiếm và so sánh
            function normalize(value) {
                return (value || "")
                    .trim()
                    .toLocaleLowerCase("vi-VN");
            }

            // Thực hiện tìm kiếm và lọc
            function applyFoodFilters() {

                const keyword = normalize(searchInput?.value);

                const selectedBrand = normalize(
                    brandFilter?.value
                );

                const selectedCategory = normalize(
                    categoryFilter?.value
                );

                const selectedStatus = statusFilter?.value || "all";

                let visibleCount = 0;

                rows.forEach(function (row) {

                    const foodName = normalize(
                        row.querySelector(".food-name")?.textContent
                    );

                    const brand = normalize(row.dataset.brand);
                    const category = normalize(row.dataset.category);
                    const status = row.dataset.status || "";

                    // Điều kiện tìm kiếm theo tên món
                    const matchesKeyword =
                        foodName.includes(keyword);

                    // Điều kiện lọc thương hiệu
                    const matchesBrand =
                        selectedBrand === "all" ||
                        brand === selectedBrand;

                    // Điều kiện lọc danh mục
                    const matchesCategory =
                        selectedCategory === "all" ||
                        category === selectedCategory;

                    // Điều kiện lọc trạng thái
                    const matchesStatus =
                        selectedStatus === "all" ||
                        status === selectedStatus;

                    // Kết hợp tất cả điều kiện
                    const isVisible =
                        matchesKeyword &&
                        matchesBrand &&
                        matchesCategory &&
                        matchesStatus;

                    row.style.display = isVisible ? "" : "none";

                    if (isVisible) {
                        visibleCount++;
                    }
                });

                // Hiển thị thông báo khi không có kết quả
                if (emptyMessage) {

                    emptyMessage.textContent =
                        totalRows === 0
                            ? "Chưa có món ăn nào trong hệ thống."
                            : "Không tìm thấy món ăn phù hợp.";

                    emptyMessage.style.display =
                        visibleCount === 0 ? "block" : "none";
                }

                // Cập nhật số lượng món ăn
                if (foodCount) {
                    foodCount.textContent =
                        `Hiển thị ${visibleCount} / ${totalRows} món ăn`;
                }
            }

            // Gắn sự kiện tìm kiếm
            if (searchInput) {
                searchInput.addEventListener(
                    "input",
                    applyFoodFilters
                );
            }

            // Gắn sự kiện lọc thương hiệu
            if (brandFilter) {
                brandFilter.addEventListener(
                    "change",
                    applyFoodFilters
                );
            }

            // Gắn sự kiện lọc danh mục
            if (categoryFilter) {
                categoryFilter.addEventListener(
                    "change",
                    applyFoodFilters
                );
            }

            // Gắn sự kiện lọc trạng thái
            if (statusFilter) {
                statusFilter.addEventListener(
                    "change",
                    applyFoodFilters
                );
            }

            // Khởi tạo bộ lọc
            applyFoodFilters();

        });
    </script>
}
